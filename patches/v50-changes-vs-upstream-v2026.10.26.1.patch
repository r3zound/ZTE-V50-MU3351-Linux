@@ -12,3 +13,21 @@ start_service() {
 	procd_set_param respawn 3600 10 0
 	procd_close_instance
 }
+
+stop_service() {
+	# Without this, stop - and every restart - leaves the old instance running: rc.common has no stop of its
+	# own for a procd instance, so nothing ever reaches it. A second mu300-keys then opens the same gpio-keys,
+	# and every key press is handled twice: a band switch twice over is no switch at all, so the key looks
+	# dead while everything it controls works. Measured on the V50, 2026-10-10: two readers after one restart.
+	#
+	# procd only knows /opt/mu300/bin/mu300-buttons. mu300-keys is that script's child and it is the one that
+	# reads the input device, so it is found by name in /proc rather than signalled through procd.
+	#
+	# cat, not `< "$d/cmdline"`: a process that exits between the glob and the read makes the shell's own
+	# redirection fail, and rc.common stops on it - which showed up here as a restart that died halfway.
+	for d in /proc/[0-9]*; do
