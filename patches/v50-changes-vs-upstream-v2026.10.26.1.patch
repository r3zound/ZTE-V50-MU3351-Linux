new file mode 100644
index 0000000..59a6ece
--- /dev/null
+++ b/openwrt/vendor-extra/etc/apk/repositories.d/distfeeds.list
@@ -0,0 +1,55 @@
+# apk package feeds - pinned to the Tsinghua (TUNA) mirror of downloads.openwrt.org.
+#
+# This file REPLACES the one baked into the rootfs tarball: openwrt/build-rootfs.sh does
+# `cp -a /in/overlay/. $R/` after unpacking the image, so this copy is the one that survives.
+# A device installed from a PREBUILT release never reads openwrt/overlay/, which is why step 7
+# of apply-v50-patches.ps1 mirrors this file into openwrt/vendor-extra/ as well.
+#
+# Measured on the V50 over 4G (2026-10-10), the same 8 indexes, same device, same minute:
+#   downloads.openwrt.org            8/8 reachable, 1.54 MB in 18 s, apk update 7 s
+#   mirrors.tuna.tsinghua.edu.cn     8/8 reachable, 1.54 MB in  8 s, apk update 4 s
+#   mirrors.aliyun.com/openwrt       0/8 reachable (all 404),         apk update FAILS (rc=8)
+# The TUNA copy is byte-identical to the official index (sha256 of
+# packages/aarch64_generic/base/packages.adb matches downloads.openwrt.org exactly), and
+# `apk update` reports the same 11178 packages from either.
+#
+# WHY NOT ALIYUN, since mirrors.aliyun.com/openwrt is the obvious first guess:
+# that mirror's releases/ tree stops at 25.12.0-rc2 and does not carry 25.12.6, the release
+# this image is built from (openwrt/build-rootfs.sh: MU300_WRT_VER defaults to 25.12.6).
+# Every one of the 8 index URLs 404s there, so `apk update` exits 8 and only 226 packages
+# remain visible instead of 11178 - the device looks like it has a working package manager
+# right up until something is actually installed. Verified on the device, not inferred.
+#
+# Other mirrors measured to carry the same 8 indexes with identical bytes (all 8/8, all
+# 20/20 on repeated requests), should TUNA ever be unreachable:
+#   https://mirrors.ustc.edu.cn/openwrt/
+#   https://mirror.sjtu.edu.cn/openwrt/
+#   https://mirror.nju.edu.cn/openwrt/
+#   https://mirrors.bfsu.edu.cn/openwrt/
+#   https://mirrors.cloud.tencent.com/openwrt/
+# Do NOT use https://repo.huaweicloud.com/openwrt/ : it answers 200 with an HTML page for
+# paths that do not exist, so a HEAD probe reports "available" for a feed that is not there.
+#
+# To go back to upstream, replace the host below with https://downloads.openwrt.org - the
+# paths do not change.
+#
+# THE VERSION SEGMENT AND THE KMODS PATH FOLLOW THE OPENWRT RELEASE, NOT THE RUNNING
+# KERNEL.  The kmods directory is named after the kernel the OpenWrt userspace was built
+# against, and that is what the other seven indexes expect.  The kernel this device
+# actually boots is mu300's own mainline 7.3.0, and the modules it needs are not modules
+# at all: CONFIG_TUN, CONFIG_NFT_TPROXY and CONFIG_NFT_SOCKET are built into it (=y).  The
+# kmod-* packages from the release therefore land in /lib/modules/6.12.112/ and are not
+# loadable by the running kernel - harmless, but do not read it as "the kmod packages do
+# the work".  Changing the version segment or the kmods path is NOT a fallback: an index
+# built for another release is a wrong answer, not a spare one.
+#
+# Contents are comments and 8 URLs; this file is read by apk, not by a shell.
+
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.6/targets/armsr/armv8/packages/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.6/packages/aarch64_generic/base/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.6/targets/armsr/armv8/kmods/6.12.112-1-67e205f26d0458c4d12f1fd315216398/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.6/packages/aarch64_generic/luci/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.6/packages/aarch64_generic/packages/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.6/packages/aarch64_generic/routing/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.6/packages/aarch64_generic/telephony/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.6/packages/aarch64_generic/video/packages.adb
diff --git a/openwrt/vendor-extra/etc/hotplug.d/iface/10-mu300-usb b/openwrt/vendor-extra/etc/hotplug.d/iface/10-mu300-usb
new file mode 100755
index 0000000..2f9b101
--- /dev/null
+++ b/openwrt/vendor-extra/etc/hotplug.d/iface/10-mu300-usb
@@ -0,0 +1,88 @@
+#!/bin/sh
+# MU300: the LAN is up - the hand-over from the early DHCP server, then the macOS re-enumeration.
+[ "$ACTION" = ifup ] && [ "$INTERFACE" = lan ] || exit 0
+
+# K9 (ported from the kanoqwq fork, cd4fb28 and 4e70d02): dnsmasq serves the LAN now, so the early server of
+# preinit (06_mu300_early_usb) goes. Then the address boot/init and preinit put on the gadget's netdev: netifd can leave it
+# there after enslaving the netdev to br-lan, which makes two equal routes for the LAN subnet; replies then leave
+# through the wrong device and the host cannot even ping br-lan. It is taken off a bridge port only when it is the
+# bridge's own, after netifd has put that on br-lan. And rndis0: an installed system's bridge section may predate a
+# switch to RNDIS, so it is put back into br-lan on every LAN ifup (a network reload too).
+#
+# The gadget's netdev joins the bridge before anything is taken off it: the loop below can only take the address
+# off a port that already is one. The other way round (until 2026-10-07), rndis0 - which an install that switched
+# to RNDIS later does not have in its bridge section - was not a port yet when the loop ran, kept the address
+# while br-lan held the same one, and neither the Wi-Fi clients nor the USB host could use the LAN (issue #45,
+# measured on a user's F50; the serial console was the only way in).
+if [ -e /sys/class/net/rndis0 ]; then
+	ip link set rndis0 master br-lan 2>/dev/null
+	ip link set rndis0 up 2>/dev/null
+fi
+# ... and the same address check once more, now that rndis0 is a port.
+#
+# The loop above only looks at netdevs that are already ports of br-lan, and rndis0 was put into
+# br-lan on the line before this one - so on a system whose gadget is RNDIS it was never checked.
+# Left holding the early server's address, the LAN subnet gets two equal routes and replies leave
+# through rndis0: a Wi-Fi client that has associated cannot even ping br-lan. (V50, 2026-10-10)
+if [ -n "$bridge_ip" ]; then
+	for nic in usb0 rndis0; do
+		ip -o link show dev "$nic" 2>/dev/null | grep -q 'master br-lan' || continue
+		nic_ip=$(ip -4 -o addr show dev "$nic" 2>/dev/null |
+			awk -v a="${bridge_ip%/*}" '{ split($4, p, "/"); if (p[1] == a) { print $4; exit } }')
+		[ -n "$nic_ip" ] || continue
+		ip addr del "$nic_ip" dev "$nic" 2>/dev/null || true
+	done
+fi
+pid=$(cat /run/mu300-early-udhcpd.pid 2>/dev/null)
+[ -n "$pid" ] && kill "$pid" 2>/dev/null
+rm -f /run/mu300-early-udhcpd.pid
+bridge_ip=$(ip -4 -o addr show dev br-lan 2>/dev/null | awk 'NR == 1 { print $4 }')
+if [ -n "$bridge_ip" ]; then
+	for nic in usb0 rndis0; do
+		ip -o link show dev "$nic" 2>/dev/null | grep -q 'master br-lan' || continue
+		# the bridge's address with whatever prefix the port has (preinit's mask can differ from netifd's)
+		nic_ip=$(ip -4 -o addr show dev "$nic" 2>/dev/null |
+			awk -v a="${bridge_ip%/*}" '{ split($4, p, "/"); if (p[1] == a) { print $4; exit } }')
+		[ -n "$nic_ip" ] || continue
+		ip addr del "$nic_ip" dev "$nic" 2>/dev/null || true
+	done
+fi
+
+# A caller that just rebound the gadget needs the LAN handoff above, not another rebind.
+# Otherwise adbd/usb-reset and this hook keep disconnecting each other.
+[ "${MU300_USB_SKIP_REBIND:-0}" = 1 ] && exit 0
+
+# The ECM gadget was bound in the initramfs; macOS keeps the link inactive after netifd reconfigures usb0
+# (at boot and on every network restart). Re-enumerate the gadget whenever the LAN comes up, at most every 20 s,
+# so the host starts DHCP on a fresh link. (Kept, K10: the fork replaces it with one rebind in mu300-post, K12,
+# which waits for its gate on macOS.)
+stamp=/tmp/mu300-usb-rebound
+now=$(cut -d. -f1 /proc/uptime)
+[ -e $stamp ] && [ $((now - $(cat $stamp))) -lt 20 ] && exit 0
+echo "$now" > $stamp
+C=/sys/kernel/config
+grep -q " $C configfs" /proc/mounts || mount -t configfs configfs $C 2>/dev/null
+g=$C/usb_gadget/linux
+[ -e $g/UDC ] || exit 0
+udc=$(cat $g/UDC)
+[ -n "$udc" ] || udc=$(ls /sys/class/udc | head -1)
+# The gadget netdevs that are bridge ports now: after the rebind they are made ports again, should the rebind have
+# left one bare (a netdev with no server, the early one being gone, and no LAN for the USB host; netifd puts back a
+# port that is in its configuration, usb0, never one it never had, rndis0 - issue #45). A netdev that is not a port
+# stays out: a user who took usb0 out of br-lan for an interface of its own keeps it that way.
+ports=
+for nic in usb0 rndis0; do
+	ip -o link show dev "$nic" 2>/dev/null | grep -q 'master br-lan' && ports="$ports $nic"
+done
+(
+	sleep 2
+	echo "" > $g/UDC 2>/dev/null
+	sleep 1
+	echo "$udc" > $g/UDC && logger -t mu300 "usb gadget re-enumerated on $udc"
+	sleep 1
+	for nic in $ports; do
+		[ -e /sys/class/net/$nic ] || continue
+		ip link set "$nic" master br-lan 2>/dev/null
+		ip link set "$nic" up 2>/dev/null
+	done
+) &
diff --git a/openwrt/vendor-extra/etc/init.d/mu300-buttons b/openwrt/vendor-extra/etc/init.d/mu300-buttons
new file mode 100755
index 0000000..d0d00c2
--- /dev/null
+++ b/openwrt/vendor-extra/etc/init.d/mu300-buttons
@@ -0,0 +1,33 @@
+#!/bin/sh /etc/rc.common
+# the buttons: power wakes the LEDs (held: shut down), the U30 Air's Wi-Fi key switches the hotspot band
+# (see /opt/mu300/bin/mu300-buttons). The V50 has one key instead (KEY_FN 464): a press switches the band,
+# a 10 s hold reboots.
+START=95
+USE_PROCD=1
+export PATH="$PATH:/opt/mu300/busybox-bin"
+
+start_service() {
+	[ -x /opt/mu300/bin/mu300-keys ] || return 0
+	procd_open_instance buttons
+	procd_set_param command /opt/mu300/bin/mu300-buttons
+	procd_set_param respawn 3600 10 0
+	procd_close_instance
+}
+
+stop_service() {
+	# Without this, stop - and every restart - leaves the old instance running: rc.common has no stop of its
+	# own for a procd instance, so nothing ever reaches it. A second mu300-keys then opens the same gpio-keys,
+	# and every key press is handled twice: a band switch twice over is no switch at all, so the key looks
+	# dead while everything it controls works. Measured on the V50, 2026-10-10: two readers after one restart.
+	#
+	# procd only knows /opt/mu300/bin/mu300-buttons. mu300-keys is that script's child and it is the one that
+	# reads the input device, so it is found by name in /proc rather than signalled through procd.
+	#
+	# cat, not `< "$d/cmdline"`: a process that exits between the glob and the read makes the shell's own
+	# redirection fail, and rc.common stops on it - which showed up here as a restart that died halfway.
+	for d in /proc/[0-9]*; do
+		case "$(cat "$d/cmdline" 2>/dev/null | tr '\0' ' ')" in
+		*mu300-keys*|*"/opt/mu300/bin/mu300-buttons"*) kill "${d#/proc/}" 2>/dev/null ;;
+		esac
+	done
+}
diff --git a/openwrt/vendor-extra/etc/init.d/mu300-hw b/openwrt/vendor-extra/etc/init.d/mu300-hw
new file mode 100755
index 0000000..cf9dc22
--- /dev/null
+++ b/openwrt/vendor-extra/etc/init.d/mu300-hw
@@ -0,0 +1,103 @@
+#!/bin/sh /etc/rc.common
+# Hardware bring-up before netifd: vendor drivers, zram, Wi-Fi (SC2355), first-boot Wi-Fi config, Bluetooth off
+START=12
+export PATH="$PATH:/opt/mu300/busybox-bin"
+
+# Everything here runs in the background on purpose. busybox init only spawns the consoles after sysinit has
+# finished, so anything slow (or hanging) in here costs the device its serial console *and* its network - which
+# is exactly what a hanging wifi-start did on the mainline kernel, leaving no way in at all.
+# Run a bring-up step under a deadline, killing the whole process tree if it overruns.
+#
+# Why this exists (V50, 2026-10-09): this script runs before netifd, and a hanging step here costs the
+# device its network and its login - busybox init only spawns the consoles after sysinit returns. The
+# SC2355/Marlin3 stack (wcn_bsp, sprd_wlan_combo) is the known offender: insmod of sprd_wlan_combo can
+# block for good on a board whose WLAN firmware differs from the tested one, and `wifi up` waits on the
+# same driver. When that happened the hotspot still associated and dnsmasq even answered DHCP, but
+# dropbear and uhttpd never came up, so the device was unreachable with nothing on screen saying why.
+# Every step is therefore bounded: whatever fails, the rest of the boot continues and the SSH console
+# stays available to look at it.
+bringup_step() {  # bringup_step DEADLINE_SECONDS NAME COMMAND...
+	_bg_deadline=$1; _bg_name=$2; shift 2
+	_bg_pid=
+	( "$@" ) >>/tmp/mu300-$_bg_name.log 2>&1 &
+	_bg_pid=$!
+	_bg_n=0
+	while kill -0 "$_bg_pid" 2>/dev/null; do
+		if [ "$_bg_n" -ge "$_bg_deadline" ]; then
+			echo "$_bg_name: exceeded ${_bg_deadline}s, killed (continuing the boot)" >>/tmp/mu300-$_bg_name.log 2>&1
+			# the step may have children (modprobe -> insmod, wifi -> hostapd): kill the group
+			kill -TERM -"$_bg_pid" 2>/dev/null || kill -TERM "$_bg_pid" 2>/dev/null
+			sleep 2
+			kill -KILL -"$_bg_pid" 2>/dev/null || kill -KILL "$_bg_pid" 2>/dev/null
+			break
+		fi
+		sleep 1
+		_bg_n=$((_bg_n + 1))
+	done
+	wait "$_bg_pid" 2>/dev/null
+	return 0
+}
+
+boot() {
+	/opt/mu300/bin/mu300-led power on
+	/opt/mu300/bin/mu300-usb boot
+	# the kernel's module helper once its table is made (~2 s; FINDINGS 163)
+	/opt/mu300/bin/mu300-modprobe-guard --prepare > /tmp/mu300-modprobe-guard.log 2>&1 &
+	hw_bringup > /tmp/mu300-hw.log 2>&1 &
+}
+
+hw_bringup() {
+	# The rules first, then the chip: cfg80211 looked for regulatory.db before the rootfs was mounted, and with the
+	# database and the country in place before the phy appears, netifd's own start of hostapd (it starts one as soon
+	# as the phy is there) already runs under them. The Wi-Fi then comes before the vendor extras and zram, which held
+	# it back ~2 s at every boot (10 modprobes of modules this kernel does not have, and the Mali GPU's).
+	bringup_step 20 regdb-load /opt/mu300/bin/regdb-load
+	country=$(uci -q get wireless.radio0.country)
+	[ -n "$country" ] && iw reg set "$country"
+	# the Marlin3 stack: insmod of sprd_wlan_combo can block for good, so this is the bounded one that matters
+	bringup_step 90 wifi-start /opt/mu300/bin/wifi-start
+	bringup_step 60 extra-modules /opt/mu300/bin/extra-modules
+	bringup_step 30 zram-start /opt/mu300/bin/zram-start
+	cfg=$(md5sum /etc/config/wireless 2>/dev/null)
+	bringup_step 45 openwrt-wifi-config /opt/mu300/bin/openwrt-wifi-config
+	# a hotspot set to WPA3/SAE (the U30 Air's SAE offload, now disabled: docs/U30AIR-SAE.md, FINDINGS 80) becomes
+	# WPA2-PSK with the same password, before the Wi-Fi restart below, which is the start that brings the hotspot up
+	# (netifd's own, earlier one ends AP-DISABLED under the world regulatory domain; the wifi-scripts refuse SAE)
+	/opt/mu300/bin/openwrt-wifi-wpa2-only migrate >>/tmp/mu300-wifi-start.log 2>&1
+	# the U30 Air's NFC tag: the hotspot's name and password, if that is what it holds (see mu300-nfc)
+	[ "$(/opt/mu300/bin/mu300-device)" = u30air ] && bringup_step 20 mu300-nfc /opt/mu300/bin/mu300-nfc sync
+	# apply the country before netifd starts hostapd, otherwise 5 GHz channels are still NO-IR under world rules
+	country=$(uci -q get wireless.radio0.country)
+	if [ -n "$country" ]; then
+		iw reg set "$country"
+		for n in $(seq 1 10); do iw reg get | grep -q "country $country:" && break; sleep 1; done
+	fi
+	# Unchanged settings and an access point that netifd's own start brought up: nothing to redo. The down/up below
+	# took a hotspot that was up (and the chip under it: a power cycle and a firmware load) down again for ~4 s at
+	# every boot.
+	if [ "$(md5sum /etc/config/wireless 2>/dev/null)" = "$cfg" ] && ap_enabled_soon; then
+		echo "access point up under the configured rules, no restart" >>/tmp/mu300-wifi-start.log
+		return 0
+	fi
+	# a reload does not restart a hostapd interface that went AP-DISABLED while the world regulatory domain
+	# was still active; one down/up right after the country is live does
+	bringup_step 60 wifi-down wifi down
+	bringup_step 60 wifi-up wifi up
+}
+
+# ap_enabled_soon: true once hostapd reports wlan0 ENABLED (20 s at most); false when it gives up (DISABLED) or never
+# gets there
+ap_enabled_soon() {
+	for n in $(seq 1 100); do
+		case $(ubus -S call hostapd.wlan0 get_status 2>/dev/null | jsonfilter -e '@.status' 2>/dev/null) in
+			ENABLED) return 0 ;;
+			DISABLED) return 1 ;;
+		esac
+		/opt/mu300/bin/busybox sleep 0.2 2>/dev/null || sleep 1
+	done
+	return 1
+}
+
+start() {
+	boot
+}
diff --git a/openwrt/vendor-extra/etc/init.d/mu300-post b/openwrt/vendor-extra/etc/init.d/mu300-post
new file mode 100755
index 0000000..35f6f4f
--- /dev/null
+++ b/openwrt/vendor-extra/etc/init.d/mu300-post
@@ -0,0 +1,68 @@
+#!/bin/sh /etc/rc.common
+# After boot: keep mobile data up across modem resets, and mark the boot successful (re-arm the Linux slot if Linux
+# is the default)
+START=99
+USE_PROCD=1
+export PATH="$PATH:/opt/mu300/busybox-bin"
+
+start_service() {
+	# the commands on the PATH (/usr/bin): new ones on a system installed before they existed, and the extras'
+	/opt/mu300/bin/mu300-extra link >/dev/null 2>&1
+
+	# the host gives up asking for a DHCP lease long before this device finishes booting; if nothing took an
+	# address, make the gadget re-enumerate once, which looks like a fresh cable to the host
+	procd_open_instance usb-lease
+	procd_set_param command /opt/mu300/bin/mu300-usb-reset --if-no-lease 25
+	procd_close_instance
+	# K13 (ported from the kanoqwq fork, cd4fb28): the U30 Air has a second gadget netdev on some kernels; it
+	# belongs to the LAN like usb0
+	[ -e /sys/class/net/usb1 ] && ip link set usb1 master br-lan 2>/dev/null && ip link set usb1 up
+
+	procd_open_instance cellwatch
+	procd_set_param command /opt/mu300/bin/mobile-data watch
+	procd_set_param env MU300_NETIFD=1 PATH="$PATH"
+	procd_set_param respawn 3600 30 0
+	# its messages ("mobile data lost ... reconnecting", "no answer about the data context") go to stderr: into the
+	# system log, as on Ubuntu's journal (procd kept none of them; FINDINGS 90)
+	procd_set_param stderr 1
+	procd_close_instance
+	# the Wi-Fi LED follows hostapd's ubus object, whoever starts or stops the access point (LuCI's wireless page,
+	# the panel, "wifi down", a WCN reset, a hostapd that died): no hook of hostapd's tells mu300-led, and this
+	# replaced two minutes of looking at wlan0 after every wireless reload (and missed everything else)
+	procd_open_instance ledevents
+	procd_set_param command /opt/mu300/bin/mu300-led events
+	procd_set_param env PATH="$PATH"
+	procd_set_param respawn 3600 5 0
+	procd_close_instance
+	procd_open_instance thermalguard
+	procd_set_param command /opt/mu300/bin/thermal-guard
+	procd_set_param env PATH="$PATH"
+	procd_close_instance
+	# the SC2355 sometimes refuses the first IFF_UP (EIO); if the AP did not come up, try once more
+	procd_open_instance wifiretry
+	procd_set_param command /bin/sh -c "sleep 45; [ -e /sys/class/net/wlan0 ] || exit 0; ubus call hostapd.wlan0 get_status >/dev/null 2>&1 || { logger -t mu300-post 'AP not up, retrying'; wifi up; sleep 15; }; /opt/mu300/bin/mu300-led wifi sync"
+	procd_close_instance
+	# a newer release: a note at login (/etc/profile.d/mu300-update.sh) and in mu300-toolkit, nothing installed
+	procd_open_instance updatenotice
+	procd_set_param command /bin/sh -c "sleep 300; while :; do /opt/mu300/bin/mu300-update notice >/dev/null 2>&1 && s=21600 || s=3600; sleep \$s; done"
+	procd_set_param env PATH="$PATH"
+	procd_close_instance
+# Re-arm the Linux slot only once the device is actually reachable.
+	#
+	# Upstream does this unconditionally 30 s after the service starts, which marks a boot "good" even when
+	# OpenWrt came up but dropbear and uhttpd never did (V50, 2026-10-09). mu300-next-boot --rearm also
+	# clears the initramfs counter .mu300/boot-tries, so an unconditional re-arm resets BOTH fallback
+	# counters on every boot and the device can never return to Android on its own - power cycling stops
+	# helping entirely. Ubuntu's mu300-boot-ok waits for the USB network and SSH first; do the same here.
+	# ':0016 .* 0A' is a listening socket on port 22 in /proc/net/tcp.
+	procd_open_instance bootok
+	procd_set_param command /bin/sh -c "for i in $(seq 1 10); do grep -q ':0016 .* 0A ' /proc/net/tcp && { exec /opt/mu300/bin/mu300-next-boot --rearm; }; sleep 30; done; logger -t mu300-post 'no SSH after 5 min: not re-arming (the next boot returns to Android)'"
+	procd_set_param env PATH="$PATH"
+	procd_close_instance
+	# Once per boot: record (and if needed repair) what decides whether a Wi-Fi client gets an address.
+	# See opt/mu300/bin/mu300-lancheck - without it a boot that serves nobody looks identical to a good one.
+	procd_open_instance lancheck
+	procd_set_param command /opt/mu300/bin/mu300-lancheck
+	procd_set_param env PATH="$PATH"
+	procd_close_instance
+}
diff --git a/openwrt/vendor-extra/etc/uci-defaults/90-mu300 b/openwrt/vendor-extra/etc/uci-defaults/90-mu300
new file mode 100755
index 0000000..6d5b124
--- /dev/null
+++ b/openwrt/vendor-extra/etc/uci-defaults/90-mu300
@@ -0,0 +1,200 @@
+#!/bin/sh
+# The MU300's OpenWrt settings: what the system needs on every run, and first-install defaults once.
+#
+# This runs more than once: mu300-update apply and android-install.sh UPDATE=1 unpack a fresh rootfs (which carries
+# /etc/uci-defaults again) and keep /etc/config, so it runs on the first boot after every update, against the
+# user's settings.
+#
+# Once (a first install): one LAN for USB and Wi-Fi (192.168.77.1/24 on an F50, 192.168.78.1/24 on a U30 Air, 192.168.79.1/24 on a V50) with
+# the USB gadget in its bridge, no wan6, an empty APN, the hostname and time zone, and fw4's software flowtable. The
+# marker system.mu300.defaults is written last, in /etc/config with the settings it guards: an update keeps both, a
+# fresh or reset configuration has neither and gets the defaults again.
+# An install from before the marker is told by its wan: only this script makes wan the modem's (proto mu300cell),
+# and no first boot has that, so such a configuration was set up by an earlier run and keeps its settings. It gets
+# the one default the releases before the marker did not set (the flowtable), and the marker.
+#
+# Every run: wan is the modem's, the LAN bridge does not wait for a missing member, the USB host's pinned lease when
+# there is none (K25), the early USB path's firewall zone (K26), logd's 1 MiB buffer over a stock size, and the USB
+# serial console in the fresh inittab.
+# /etc/config/network can hold a password (the APN's, FINDINGS 65; a PPPoE or WireGuard one): root's alone from the
+# first boot on, before anybody types one in. uci keeps the mode of a file it rewrites. (No link is followed.)
+[ -f /etc/config/network ] && [ ! -L /etc/config/network ] && chmod 600 /etc/config/network 2>/dev/null
+lan_ip=$(/opt/mu300/bin/mu300-lan-ip)
+# The USB host's MAC (K25): boot/init leaves it in /run (the gadget's host_addr); else the gadget's own address
+# tells it (init gives the host the next one: :01 -> :02 for usb0, :03 -> :04 for rndis0).
+usb_host_mac=$(cat /run/mu300-usb-host-mac 2>/dev/null)
+for nic in usb0:02 rndis0:04; do
+	[ -z "$usb_host_mac" ] || break
+	devmac=$(cat /sys/class/net/${nic%:*}/address 2>/dev/null)
+	[ -n "$devmac" ] && usb_host_mac=${devmac%:*}:${nic#*:}
+done
+dev=$(uci -q show network | sed -n "s/^network\.\(@device\[[0-9]*\]\)\.name='br-lan'$/\1/p" | head -1)
+
+# first (a first install), old (an install from before the marker) or done; told before wan is set below
+if [ "$(uci -q get system.mu300.defaults)" = 1 ]; then run=done
+elif [ "$(uci -q get network.wan.proto)" = mu300cell ]; then run=old
+else run=first
+fi
+
+if [ "$run" = first ]; then
+	# lan ip6assign 64: a carrier hands out one /64 (the wan_6 that mu300cell adds), and the default /60 request
+	# would leave the LAN without IPv6 (openwrt-luci's 91-mu300-luci, run after this, asks for a /60 of the ULA)
+	uci -q batch <<UCI
+set system.@system[0].hostname='ZTE-V50'
+set system.@system[0].zonename='Asia/Shanghai'
+set system.@system[0].timezone='CST-8'
+# The regulatory domain decides which channels may radiate at all (see the note above step 16):
+# with none set, cfg80211 stays on the world domain, every 5 GHz channel is NO-IR, and hostapd refuses
+# to start the AP - the device boots with no hotspot and says nothing. US allows the most power of the
+# countries measured here on 2.4 GHz (30 dBm; BO and CN allow 20) and permits an AP on the low 5 GHz
+# channels too.  Change it with:  uci set wireless.radio0.country='DE'; uci commit wireless; wifi reload
+set wireless.radio0.country='US'
+set network.lan.ipaddr='$lan_ip'
+set network.lan.netmask='255.255.255.0'
+set network.lan.ip6assign='64'
+delete network.wan6
+set network.wan=interface
+set network.wan.apn=''
+UCI
+	# the armsr default bridges eth0; the MU300 LAN bridge carries the USB gadget (Wi-Fi joins via wireless config)
+	if [ -n "$dev" ]; then
+		uci -q delete network.$dev.ports
+		uci add_list network.$dev.ports='usb0'
+		# the gadget's RNDIS netdev (Windows without NCM) exists only when init made RNDIS; the LAN hook
+		# (hotplug.d/iface/10-mu300-usb) bridges it when a later boot does (K27, kanoqwq fork cd4fb28 and 4e70d02)
+		[ -e /sys/class/net/rndis0 ] && uci add_list network.$dev.ports='rndis0'
+	fi
+fi
+if [ "$run" != done ]; then
+	# Forwarded TCP/UDP through the kernel's software flowtable (fw4 puts sipa_eth0 in it: patches/fw4-sipa-offload.patch).
+	# The Unisoc SIPA and SC2355 drivers have no nftables hardware flow offload. (mu300-ttl turns it off while a TTL
+	# is set.)
+	# Flow offload stays OFF (V50, 2026-10-10).
+	# It was on, and it broke forwarding: the WAN's device appears only after the modem
+	# dials, so fw4 renders accept_to_wan empty at boot, and the hotplug that would fix it
+	# (hotplug.d/iface/20-firewall, which runs 'fw4 -q reload') cannot: replacing the
+	# flowtable while flows are in it fails with Resource busy, and -q hides the error.
+	# Every forwarded TCP was then RST by handle_reject, while the router's own DNS kept
+	# working - so it reads as 'the hotspot has no DNS'. See docs/04-WiFi与DHCP根因分析.md.
+	# SIPA and SC2355 have no hardware offload anyway, so little is lost.
+	uci -q set firewall.@defaults[0].flow_offloading='0'
+	uci -q set firewall.@defaults[0].flow_offloading_hw='0'
+fi
+
+# --- every run
+uci -q batch <<UCI
+set network.wan=interface
+set network.wan.proto='mu300cell'
+UCI
+# the wired LAN does not wait for a member that is not there yet (Wi-Fi, a gadget netdev)
+[ -z "$dev" ] || uci set network.$dev.bridge_empty='1'
+# board.json names the LAN device "eth0" - a leftover from the armsr target, on a board that has no
+# eth0. LuCI's status page reads it as the builtin ethernet ports, so it listed a port that can never
+# come up and reported it as disconnected for ever. config_generate writes this file only when the
+# image is built, so the stale value survives every install and every update; nothing else fixes it.
+# The UCI side is already right, so copy that across. (V50, 2026-10-10)
+mu300_board_dev=$(uci -q get network.lan.device)
+if [ -n "$mu300_board_dev" ] && [ -f /etc/board.json ]; then
+	sed -i "s/\"device\": \"eth0\"/\"device\": \"$mu300_board_dev\"/" /etc/board.json 2>/dev/null || true
+fi
+# K25 (ported from the kanoqwq fork, cd4fb28): the USB host keeps the address it had from the early server, and
+# dnsmasq broadcasts its OFFER/ACK: Windows can keep asking for the early lease after it has already removed that
+# address, and a unicast reply to the removed address is lost in the NCM host stack. The address is the one preinit's
+# early server gives on the LAN as configured (lib/mu300/usb-host.sh: never the router's own). Added when there is
+# none (an install from before K25, or a host MAC not known yet); one that is there is left as it is.
+. /lib/mu300/usb-host.sh
+if [ -n "$usb_host_mac" ] && [ -z "$(uci -q get dhcp.mu300_usb)" ]; then
+	mu300_lan "$(uci -q get network.lan.ipaddr)" "$(uci -q get network.lan.netmask)"
+	usb_host_ip=$(mu300_usb_host_ip "${mu300_lan_addr:-$lan_ip}" "$mu300_lan_mask")
+	uci -q batch <<UCI
+set dhcp.mu300_usb=host
+set dhcp.mu300_usb.name='mu300-usb-host'
+set dhcp.mu300_usb.mac='$usb_host_mac'
+set dhcp.mu300_usb.ip='$usb_host_ip'
+set dhcp.mu300_usb.broadcast='1'
+UCI
+fi
+# K26 (same fork commit): before netifd makes br-lan, the early address lives on the gadget's netdev itself (preinit
+# 06_mu300_early_usb); the host's DHCP and management traffic there gets the LAN's input policy, never forwarding.
+# Bridged, the packets come in through br-lan as usual. Added once.
+if ! uci -q show firewall | grep -q "^firewall\.@zone\[[0-9]*\]\.name='earlyusb'$"; then
+	early=$(uci add firewall zone)
+	uci set firewall.$early.name='earlyusb'
+	uci add_list firewall.$early.device='usb0'
+	uci add_list firewall.$early.device='rndis0'
+	uci set firewall.$early.input='ACCEPT'
+	uci set firewall.$early.output='ACCEPT'
+	uci set firewall.$early.forward='REJECT'
+fi
+# K28 (V50, 2026-10-10): the lan zone has to own the bridge itself, not only its ports.
+#
+# fw4 derives a zone's interfaces from the ports of the network's bridge device. br-lan is declared
+# bridge_empty, and wlan0 only joins it when netifd brings the AP up - after fw4 has rendered the
+# ruleset. The lan zone then owns nothing: no jump for br-lan in the input chain, policy drop, and
+# every packet a client sends is discarded. Nothing reports it - /etc/config/firewall says
+# input='ACCEPT' either way, the AP is up and dnsmasq is listening - so a client that associates simply
+# never gets a lease. Naming the bridge costs nothing and a later port cannot undo it.
+lan_dev=$(uci -q get network.lan.device)
+if [ -n "$lan_dev" ]; then
+	for z in $(uci -q show firewall | sed -n "s/^firewall\.\([^.=]*\)\.name='lan'$/\1/p"); do
+		uci -q get "firewall.$z.device" | grep -qx "$lan_dev" || uci add_list "firewall.$z.device=$lan_dev"
+	done
+fi
+# Issue #67: the lan and wan zones name their devices, not only their networks. fw4 renders a zone's rules from
+# the devices its networks have at the time, and S19 firewall runs before S20 network: on the boot ruleset neither
+# br-lan nor the modem's sipa_eth0 exists yet, so the LAN's input rules and the wan's masquerade are left out, for
+# the reload every ifup triggers to fill in. On the 5.4 kernel that reload failed (hotplug.d/iface/19-mu300-fw4),
+# and the device came up with no DHCP, no LuCI and no NAT on every boot (#67; #61 looks the same). With the devices
+# named, the boot ruleset is complete whatever the reloads do. Added to a zone that lacks its device; once.
+# sipa_eth8 is the F50's internal card's bearer (mu300-sim select internal; docs/SIM-SELECTION.md): named too, so
+# LAN clients are masqueraded on it from the boot ruleset on, the same as on sipa_eth0.
+for zd in lan:br-lan wan:sipa_eth0 wan:sipa_eth8; do
+	zone=$(uci -q show firewall | sed -n "s/^\(firewall\.@zone\[[0-9]*\]\)\.name='${zd%:*}'$/\1/p" | head -1)
+	[ -n "$zone" ] || continue
+	case " $(uci -q get $zone.device) " in *" ${zd#*:} "*) ;; *) uci add_list $zone.device="${zd#*:}" ;; esac
+done
+# LuCI's language (both systems) is English, not "auto" (which follows the browser): once, with its own marker
+# luci.mu300.lang, so a language the user picks later stays through every update. A system from before the marker
+# that still says "auto" (or nothing) gets English too: auto was nobody's choice there (luci-base's default, and
+# 91-mu300-luci's until it set English), and with the Turkish and Chinese catalogs now in the image it would switch
+# the language under the user. A language set on purpose stays.
+# The languages the image has catalogs for (Turkish and Chinese) are offered on every run: their own uci-defaults ran
+# when the image was built, and an update keeps the old /etc/config/luci, which may not know them (plain OpenWrt
+# before v2026.10.11 had none). One the user's configuration has stays as it is.
+if uci -q get luci.main >/dev/null; then
+	uci -q get luci.languages >/dev/null || uci -q set luci.languages=internal
+	[ ! -e /usr/lib/lua/luci/i18n/base.tr.lmo ] || uci -q get luci.languages.tr >/dev/null ||
+		uci -q set luci.languages.tr='Türkçe (Turkish)'
+	[ ! -e /usr/lib/lua/luci/i18n/base.zh-cn.lmo ] || uci -q get luci.languages.zh_cn >/dev/null ||
+		uci -q set luci.languages.zh_cn="$(printf '\347\256\200\344\275\223\344\270\255\346\226\207 (Simplified Chinese)')"
+	uci commit luci
+fi
+if uci -q get luci.main >/dev/null && [ "$(uci -q get luci.mu300.lang)" != 1 ]; then
+	case $(uci -q get luci.main.lang) in ''|auto) uci -q set luci.main.lang='en' ;; esac
+	uci -q batch <<UCI
+set luci.mu300=mu300
+set luci.mu300.lang='1'
+UCI
+	uci commit luci
+fi
+# logd's ring buffer (FINDINGS 191): OpenWrt's 128 KiB held only the last two minutes of an F50's log, so what the
+# services said at boot was gone before anybody looked. A boot alone writes about 500 KiB; 1 MiB of the 1.5 GB RAM
+# keeps all of it and more than an hour after. From the next start of logd (this runs before it at boot). Every
+# run, but only over the stock sizes (none, 64, 128): a size the user set stays.
+case $(uci -q get system.@system[0].log_size) in ''|64|128) uci -q set system.@system[0].log_size='1024' ;; esac
+# network last: a first run cut short before its commit has no wan proto mu300cell yet, and runs again as a first
+# install, in full
+uci commit system
+uci commit dhcp
+uci commit firewall
+uci commit network
+grep -q '^ttyGS0:' /etc/inittab || echo 'ttyGS0::askfirst:/usr/libexec/login.sh' >> /etc/inittab
+# the marker last
+if [ "$run" != done ]; then
+	uci -q batch <<UCI
+set system.mu300=mu300
+set system.mu300.defaults='1'
+UCI
+	uci commit system
+fi
+exit 0
diff --git a/openwrt/vendor-extra/opt/mu300/bin/mu300-buttons b/openwrt/vendor-extra/opt/mu300/bin/mu300-buttons
new file mode 100755
index 0000000..00ef288
--- /dev/null
+++ b/openwrt/vendor-extra/opt/mu300/bin/mu300-buttons
@@ -0,0 +1,152 @@
+#!/bin/sh
+# The buttons (Ubuntu and OpenWrt; run by mu300-buttons.service / /etc/init.d/mu300-buttons):
+#   power, short press        wake the LEDs (they go dark after LED_TIMEOUT, see mu300-led)
+#   power, held 3 s           shut down cleanly (the battery-powered U30 Air; the F50 starts again on USB power);
+#                             in the charging boot it starts the device instead, as in the stock charger mode
+#   Wi-Fi key, short press    hotspot 2.4 <-> 5 GHz (U30 Air; the Wi-Fi LED: white 5, blue 2.4, FINDINGS 152)
+#   Wi-Fi key, held 3 s       hotspot off / on
+#   function key, short press hotspot 2.4 <-> 5 GHz, with the colour flashing (mu300-led flash; the V50's one key)
+#   function key, held 10 s   reboot, all three colours flashing (mu300-led alarm) until the power goes
+# Every press lights the LEDs first (`mu300-led wake`: also in mu300-power's idle, and without any daemon), so a key
+# always shows life. Then it wakes mu300-power with the key's name (`mu300-power wake wifi|power`; other keys count as
+# power), in the background: the wake restores whatever is down by looking (hotspot, modem, LEDs, CPU), which can
+# take a minute, and the keys must not wait for it. Idle wakes on any key, a charging boot only on the Wi-Fi key. The
+# band toggle acts on an awake device, so the first Wi-Fi short press on a sleeping device (idle, or the LEDs held
+# dark) only wakes it; a long press wakes and toggles the hotspot in one go. Held power does not wake mu300-power: it leaves the shutdown marker, so the
+# daemon's stop on the way down does not bring the radios back. The hotspot toggle leaves $PST/hotspot-off (with the
+# uptime of the hold) while the user has it off, so neither a wake nor mu300-power's self-check turns it back on; the
+# direction is decided and the marker written before the wake starts, so the wake of the same press cannot undo it.
+# The toggles themselves (hotspot, band) run in the background under a deadline: a later press always shows life.
+# mu300-keys reports the presses; its tick every 5 s lets the LEDs time out and the U30 Air's battery LED follow the
+# battery. Ubuntu's logind leaves the power key to this script (/etc/systemd/logind.conf.d/mu300-buttons.conf): it
+# used to power the device off at a touch.
+export PATH="$PATH:/opt/mu300/bin:/usr/sbin:/sbin"
+KEY_POWER=116
+KEY_WIFI=138   # "Wifi Switch Key" in the U30 Air's device tree (KEY_HELP's code, as its Android maps it)
+# The V50's board has ONE key and it is neither of the two above: its device tree calls it key-function
+# with linux,code 0x1d0 = 464 = KEY_FN. Nothing matched that code, so on this device every press fell
+# through the case below and did nothing at all - no band switch, no reboot. Measured, 2026-10-10:
+#   114 KEY_VOLUMEDOWN | 115 KEY_VOLUMEUP | 190 KEY_F20 (key-power) | 464 KEY_FN (key-function)
+KEY_FN=464
+is_openwrt() { [ -e /etc/openwrt_release ]; }
+PST=${MU300_RUN:-/run}/mu300/power
+LEDIDLE=${MU300_SYSROOT:-}/run/mu300/led/.idle   # mu300-led idle on (mu300-led keeps its state there)
+
+DEADLINE=${MU300_BUTTONS_DEADLINE:-150}   # a toggle in the background (the LED sync after wifi up runs 120 s)
+
+# How long a hold is, before it is reported as "long" (mu300-keys -l). 10 s on the V50, whose single
+# key reboots the device; the upstream 3 s everywhere else, for the F50/U30 Air power key. Told by the
+# device tree and not by the model: the V50 reports the same one as the F50 (DEVICE=f50), so the model
+# cannot tell them apart, and key-function is exactly the node that only this board has.
+HOLD=${MU300_BUTTONS_HOLD:-$([ -d /proc/device-tree/gpio-keys/key-function ] && echo 10000 || echo 3000)}
+
+# --- deadlines (as in mu300-power): "PID PPID" for every process, a process tree killed, a job with a watchdog
+proc_table() {
+    if [ -r /proc/self/stat ]; then
+        for _pt in /proc/[0-9]*; do
+            { read -r _ptl < "$_pt/stat"; } 2>/dev/null || continue
+            _ptl=${_ptl##*) }; _ptl=${_ptl#* }
+            echo "${_pt#/proc/} ${_ptl%% *}"
+        done
+    else
+        ps -A -o pid= -o ppid= 2>/dev/null
+    fi
+}
+# tree_kill PID: the process and everything it started. The tree is stopped until a look finds nothing new (a child
+# forked during one look is caught by the next), then every process any look saw is killed
+tree_kill() {
+    _tk_prev= _tk_seen= _tk_n=0
+    while :; do
+        _tk_all=$(proc_table | awk -v r="$1" '{ pp[$1] = $2 } END { s[r] = 1
+            do { n = 0; for (p in pp) if (!(p in s) && (pp[p] in s)) { s[p] = 1; n++ } } while (n)
+            for (p in s) print p }' | sort -n | tr '\n' ' ')
+        for _tk in $_tk_all; do kill -STOP "$_tk" 2>/dev/null; done
+        _tk_seen="$_tk_seen $_tk_all"   # every process seen: one reparented between looks is killed too
+        _tk_n=$((_tk_n + 1)); [ "$_tk_all" != "$_tk_prev" ] && [ "$_tk_n" -lt 10 ] || break
+        _tk_prev=$_tk_all
+    done
+    for _tk in $_tk_seen; do kill -KILL "$_tk" 2>/dev/null; done
+    return 0
+}
+in_background() {  # in_background SECONDS CMD...: CMD in the background; past SECONDS it and all it started are killed
+    _ib_s=$1; shift
+    ( "$@" & _ib_p=$!
+      ( sleep "$_ib_s"; tree_kill "$_ib_p" ) </dev/null >/dev/null 2>&1 & _ib_w=$!
+      wait "$_ib_p"; kill "$_ib_w" 2>/dev/null ) </dev/null >/dev/null 2>&1 &
+}
+
+probe() {  # probe CMD...: CMD within 5 s (the direction of a hold is decided before the wake; it must not wait long)
+    "$@" </dev/null >/dev/null 2>&1 &
+    _pr_p=$!
+    ( sleep "${MU300_BUTTONS_PROBE_DEADLINE:-5}"; tree_kill "$_pr_p" ) </dev/null >/dev/null 2>&1 &
+    _pr_w=$!
+    wait "$_pr_p"; _pr_rc=$?
+    kill "$_pr_w" 2>/dev/null; wait "$_pr_w" 2>/dev/null
+    return $_pr_rc
+}
+hotspot_is_up() {
+    if is_openwrt; then probe ubus -t 5 call hostapd.wlan0 get_status
+    else probe systemctl is-active --quiet mu300-hotspot; fi
+}
+hotspot_set() {  # hotspot_set on|off: the toggle itself, and the persistent flag the panel writes
+    if is_openwrt; then
+        if [ "$1" = off ]; then
+            uci -q set wireless.@wifi-device[0].disabled=1; uci -q commit wireless
+            wifi down; mu300-led wifi off
+        else
+            uci -q set wireless.@wifi-device[0].disabled=0; uci -q commit wireless
+            wifi up; mu300-led wifi sync 120
+        fi
+    elif [ "$1" = off ]; then systemctl stop mu300-hotspot
+    else systemctl start mu300-hotspot; fi
+}
+band_toggle() { mu300-wifi-band toggle | logger -t mu300-buttons 2>/dev/null; }
+
+mu300-keys -l "$HOLD" -t 5 | { while read -r code kind; do
+    # the tick every 5 s is no press: it lets the LEDs time out, and the U30 Air's battery LED follow the charge
+    # (plugged in, unplugged, the 60 % and 10 % marks)
+    if [ "$kind" = tick ]; then mu300-led tick; continue; fi
+    mu300-led wake   # first, whatever else this key does or whatever state anything is in
+    was_idle=0; s=$(cat "$PST/state" 2>/dev/null); [ -z "$s" ] || [ "$s" = active ] || was_idle=1
+    [ ! -e "$LEDIDLE" ] || was_idle=1   # dark on purpose (idle, or someone's mu300-led idle on): this press only wakes
+    key=power; [ "$code" = "$KEY_WIFI" ] && key=wifi
+    # a Wi-Fi hold decides which way and writes the user's marker even on a sleeping device (idle, or the LEDs held
+    # dark): one press wakes and toggles, and the direction and the marker are set before the wake starts, so the
+    # wake cannot undo them. The charging boot has no services to toggle, so a hold there still only wakes.
+    dir=
+    if [ "$code $kind" = "$KEY_WIFI long" ] && [ "$s" != charging-boot ]; then
+        mkdir -p "$PST" 2>/dev/null
+        if hotspot_is_up; then dir=off; cut -d. -f1 "${MU300_SYSROOT:-}/proc/uptime" > "$PST/hotspot-off" 2>/dev/null
+        else dir=on; rm -f "$PST/hotspot-off"; fi
+    fi
+    # a held power key in the charging boot starts the device (the stock charger mode: hold power to switch it on;
+    # FINDINGS 196): the wake without a key name ends it, as the Wi-Fi key does
+    if [ "$code $kind" = "$KEY_POWER long" ] && [ "$s" = charging-boot ]; then
+        logger -t mu300-buttons "power button held in the charging boot: starting" 2>/dev/null
+        ( mu300-power wake ) </dev/null >/dev/null 2>&1 &
+        continue
+    fi
+    # a held power key shuts down instead
+    [ "$code $kind" = "$KEY_POWER long" ] || ( mu300-power wake "$key" ) </dev/null >/dev/null 2>&1 &
+    case "$code $kind" in
+        "$KEY_POWER long")
+            logger -t mu300-buttons "power button held: shutting down" 2>/dev/null
+            mkdir -p "$PST" 2>/dev/null; : > "$PST/shutdown" 2>/dev/null
+            if is_openwrt; then poweroff; else systemctl poweroff; fi ;;
+        "$KEY_WIFI short") [ "$was_idle" = 1 ] || in_background "$DEADLINE" band_toggle ;;
+        "$KEY_WIFI long") [ -z "$dir" ] || in_background "$DEADLINE" hotspot_set "$dir" ;;
+        # The V50's one key: a press switches the hotspot band, a 10 s hold reboots. The marker is left
+        # first for the same reason the hotspot toggle leaves one - a reboot must not be undone by a
+        # wake that puts the radios back.
+        # The flash comes before the switch: the reload that follows takes seconds, so the colour that answers
+        # for the new band is a while away, and without this the press would look like nothing happened.
+        # The hold flashes all three colours (the same siren thermal-guard uses) until the power goes: reboot is
+        # asynchronous, and an LED that stopped at the last colour would look like a hang.
+        "$KEY_FN short") mu300-led flash; [ "$was_idle" = 1 ] || in_background "$DEADLINE" band_toggle ;;
+        "$KEY_FN long")
+            logger -t mu300-buttons "V50 key held ${HOLD} ms: rebooting" 2>/dev/null
+            mkdir -p "$PST" 2>/dev/null; : > "$PST/reboot" 2>/dev/null
+            mu300-led alarm on
+            if is_openwrt; then reboot; else systemctl reboot; fi ;;
+    esac
+done; wait; }
diff --git a/openwrt/vendor-extra/opt/mu300/bin/mu300-lancheck b/openwrt/vendor-extra/opt/mu300/bin/mu300-lancheck
new file mode 100755
index 0000000..cb418ca
--- /dev/null
+++ b/openwrt/vendor-extra/opt/mu300/bin/mu300-lancheck
@@ -0,0 +1,99 @@
+#!/bin/sh
+# Report - and if needed repair - the LAN path a client depends on, once per boot.
+#
+# Why this exists (V50, 2026-10-09): a client could associate with the hotspot and then get nothing at all.
+# Every part that decides whether it gets an address looked right afterwards - wlan0 a port of br-lan,
+# br-lan at 192.168.77.1/24, dhcp.lan a dhcpv4 server, dnsmasq running - but nothing recorded the state
+# AT BOOT, so a broken boot could not be told from a working one. The kernel log only showed the port
+# reaching forwarding state, and the userspace log had been flooded out of the ring buffer by the
+# sprd-wlan driver before anything could read it.
+#
+# The one thing this originally got wrong is the thing that actually broke the device: "the lan zone
+# accepting input" was read out of /etc/config/firewall, where it is an option that was set. In the
+# RENDERED ruleset the lan zone owned no interface at all, so fw4's input chain had no jump for
+# br-lan and its policy dropped everything a client sent. UCI said ACCEPT; nothing on the device
+# said otherwise. Hence fw-jump below, which reads the ruleset rather than the configuration.
+#
+# So: one line per boot with those facts, written to a file and to syslog. The next boot either proves the
+# path works or names the one part that does not.
+LOG=/tmp/mu300-lancheck.log
+say() { echo "$(cut -d' ' -f1 /proc/uptime) $*" >>$LOG 2>/dev/null; logger -t mu300-lancheck "$*" 2>/dev/null; }
+
+# netifd runs after mu300-post in the boot order; wait for the LAN to get its address (up to 2 minutes)
+i=0
+while [ $i -lt 24 ]; do
+    ip -4 addr show br-lan 2>/dev/null | grep -q 'inet ' && break
+    sleep 5
+    i=$((i + 1))
+done
+
+# The hotspot has to exist, be a port of the LAN bridge, AND be carrying traffic. All three are needed,
+# and the last two are why this was rewritten (V50, mainline kernel 6.18, 2026-10-10):
+#
+#   * wlan0 sat in the bridge with NO CARRIER and hostapd already given up. The original test asked only
+#     "is wlan0 missing from brif", so it never fired and the device booted with no hotspot, no DHCP
+#     server (udp67=0) and nothing on the device looking wrong.
+#   * on the mainline kernel the FIRST bring-up always fails and a retry always succeeds:
+#         at boot           hostapd: UNINITIALIZED->COUNTRY_UPDATE->DISABLED->AP-DISABLED
+#         wifi down; wifi up  hostapd: COUNTRY_UPDATE->HT_SCAN->ENABLED->AP-ENABLED
+#     `wifi up` alone does not clear it - the interface has to go down first - so every attempt does both.
+#   * and when this runs the interface may not exist yet at all: br-lan gets its address from the lan
+#     interface, which comes up before the wireless one. Guarding the whole block with `[ -d .../wlan0 ]`
+#     (the first version of this fix did) skipped the repair in exactly the case it was written for, and
+#     the log looked like a pass. Wait for wlan0 first, then repair.
+# The regulatory database FIRST, and before the Wi-Fi is restarted below so hostapd picks the country
+# up. cfg80211 asks for regulatory.db long before the rootfs is mounted and that first load always
+# fails ("cfg80211: failed to load regulatory.db"); without it cfg80211 is stuck on the world domain,
+# where EVERY 5 GHz channel is NO-IR, and hostapd refuses to start an AP:
+#
+#     Frequency 5180 (primary) not allowed for AP mode, flags: 0x40853 NO-IR
+#     Could not select hw_mode and channel. (-3)   ->   AP-DISABLED
+#
+# Verified on the device: after this runs, `iw reg set US` reports "country US: DFS-FCC" and the same
+# AP starts on channel 36; before it, `iw reg set` does nothing and the channel is refused. opt/mu300/bin/
+# regdb-load feeds the database through /sys/class/firmware for the pending request and reloads; running
+# it here, after netifd, is what makes the country in 90-mu300 mean anything. (V50, mainline 6.18,
+# 2026-10-10)
+/opt/mu300/bin/regdb-load >/dev/null 2>&1
+
+_wi=0
+while [ $_wi -lt 12 ] && [ ! -d /sys/class/net/wlan0 ]; do
+    sleep 5
+    _wi=$((_wi + 1))
+done
+_repair=0
+while [ $_repair -lt 3 ]; do
+    _st=$(cat /sys/class/net/wlan0/operstate 2>/dev/null)
+    _port=$(ls /sys/class/net/br-lan/brif 2>/dev/null | grep -c '^wlan0$')
+    _has=$( [ -d /sys/class/net/wlan0 ] && echo yes || echo no )
+    [ "$_has" = yes ] && [ "$_st" = up ] && [ "$_port" = 1 ] && break
+    _repair=$((_repair + 1))
+    say "wlan0 not serving (exists=$_has operstate=$_st bridge-port=$_port): wifi down; wifi up (attempt $_repair)"
+    wifi down 2>/dev/null
+    sleep 3
+    wifi up 2>/dev/null
+    sleep 20
+done
+
+br=$(ip -4 addr show br-lan 2>/dev/null | sed -n 's/.*inet \([0-9.]*\/[0-9]*\).*/\1/p' | tr '\n' ' ')
+ports=$(ls /sys/class/net/br-lan/brif 2>/dev/null | tr '\n' ' ')
+wst=$(cat /sys/class/net/wlan0/operstate 2>/dev/null)
+dm=$(pgrep dnsmasq 2>/dev/null | tr '\n' ' ')
+# Listening sockets, hex ports. 0016 = 22 ssh and 0050 = 80 http are TCP and live in /proc/net/tcp;
+# 0043 = 67 dhcp is UDP and lives in /proc/net/udp. Reading 67 out of /proc/net/tcp (as this did until
+# 2026-10-10) can only ever answer "nothing is listening", however healthy the DHCP server is.
+l22=$(grep -c ':0016 .* 0A ' /proc/net/tcp 2>/dev/null)
+l80=$(grep -c ':0050 .* 0A ' /proc/net/tcp 2>/dev/null)
+l67=$(grep -c ':0043 .* 0A ' /proc/net/udp 2>/dev/null)
+# The range dnsmasq was actually started with, not the one /etc/config/dhcp asks for. The generated file
+# has no fixed name (netifd writes /var/etc/dnsmasq.conf.cfg<hash>), so glob it without demanding a suffix.
+rng=$(grep -h '^dhcp-range' /var/etc/dnsmasq.conf* 2>/dev/null | tr '\n' ';')
+# Does fw4's input chain even hand br-lan to the lan zone? This is the one that decides everything:
+# fw4 works out a zone's devices from the ports of its bridge, and br-lan is declared bridge_empty with
+# wlan0 joining only when netifd brings the AP up. When that moment came too late the lan zone owned
+# nothing, the input policy dropped every packet, and a client that had associated got no lease, no DNS,
+# no LuCI and no SSH - while dnsmasq sat on 0.0.0.0:67 with a correct dhcp-range and never saw a
+# DISCOVER. Nothing else on the device looks wrong when that happens, which is why it is reported here.
+lanif=$(uci -q get network.lan.device 2>/dev/null)
+fwlan=$(nft list chain inet fw4 input 2>/dev/null | grep -c "\"${lanif:-br-lan}\" jump")
+say "br-lan=[$br] ports=[$ports] wlan0=$wst dnsmasq=[$dm] tcp22=$l22 tcp80=$l80 udp67=$l67 fw-jump=$fwlan range=[$rng]"
diff --git a/openwrt/vendor-extra/opt/mu300/bin/mu300-led b/openwrt/vendor-extra/opt/mu300/bin/mu300-led
new file mode 100755
index 0000000..08d2aec
--- /dev/null
+++ b/openwrt/vendor-extra/opt/mu300/bin/mu300-led
@@ -0,0 +1,407 @@
+#!/bin/sh
+# The device's LEDs by what they mean, so the services need not know which device they run on.
+#   mu300-led power on|off      Linux is up (set at boot, which also wakes the LEDs; cleared at shutdown); the U30
+#                               Air's battery LED comes on with it and goes off at shutdown
+#   mu300-led data on|5g|off|error  mobile data connected (5g: over 5G) / not connected / no service (no SIM, not
+#                               registered); U30 Air: the colour is the SIM in use, not 4G/5G (below)
+#   mu300-led data switching 0|1  U30 Air: a live SIM switch to that slot is under way (mu300-sim-u30): its colour
+#                               blinks until the next "data on|5g", or "data off|error" once the switch is over
+#   mu300-led wifi on|off|sync [S]  the Wi-Fi hotspot is up (U30 Air: white on 5 GHz, blue on 2.4 GHz); sync: whatever
+#                               wlan0 is now, and again every 2 s for S seconds (OpenWrt: LuCI or the button)
+#   mu300-led events            OpenWrt: the Wi-Fi LED follows hostapd on ubus as it comes and goes (a service, no
+#                               polling: wifi down/up, LuCI, the panel, a WCN reset, a hostapd that died)
+#   mu300-led wake              show the LEDs again, for LED_TIMEOUT seconds (every key press, mu300-buttons); also
+#                               in mu300-power's idle, for LED_TIMEOUT (60 s when it is 0): a key always shows life
+#   mu300-led sleep [--if-due]  dark now (--if-due: only once the timeout has passed; mu300-buttons asks)
+#   mu300-led idle on|off       mu300-power's idle: everything dark whatever LED_TIMEOUT says, except for a key's wake;
+#                               state changes are remembered and shown on the next wake or at idle off
+#   mu300-led charge on|off     the charging boot: the power LED blinks (1 s on, 1 s off); the U30 Air's battery LED
+#                               shows the charge as always
+#   mu300-led battery           U30 Air: the battery LED as the battery is now (also at every tick)
+#   mu300-led tick              mu300-buttons, every 5 s: the battery LED, then sleep --if-due
+#   mu300-led test              each LED in turn, 2 s each, with its name (to tell which one is where)
+#   mu300-led alarm on|off      too hot (thermal-guard): the PMIC's RGB LED flashes red, white, blue one at a time
+#                               like a siren, also while the others are dark
+#   mu300-led flash             the colour that is lit flashes LED_KEY_FLASH_COUNT times and settles again: a key
+#                               that acted says so (V50: the one key switches the band, and the reload that follows
+#                               takes seconds, so the new colour is a while away)
+# ZTE F50 (read from its Android): network = the PMIC's RGB LED, blue on 4G, white (its "green" channel) on 5G, red
+#   without service; Wi-Fi = the PMIC's keypad backlight sink ("keyboard-backlight"), at ZTE's 48 of 127, whichever
+#   band. No power LED. ZTE U30 Air (found by lighting each one):
+#   battery  the PMIC's RGB LED: its "green" channel is white, red, blue. As ZTE's firmware (FINDINGS 151): white
+#            at 60 % and above, blue from 10 %, red below; steady on the battery, breathing while it charges (the
+#            PMIC's own curve, 2 s), steady white when full on the charger. On outside power no LED times out; below
+#            10 % on the battery the red one does not either. The heat alarm goes over it.
+#   network  as ZTE's firmware: the SIM in use, not the access technology (FINDINGS 154): white for slot 0, the
+#            nano-SIM (LDO VDDCAMA0), blue for slot 1, the built-in eSIM (a GPIO, net_blue), red without service
+#            (the PMIC's keypad backlight sink, "keyboard-backlight" under 5.4 and mainline); the slot is this boot's
+#            pin, /run/mu300/sim-slot (slot 1 only where it is supported: OpenWrt), so a live switch recolours it
+#   Wi-Fi    as ZTE's firmware: white on 5 GHz (LDO VDDCAMA1), blue on 2.4 GHz (LDO VDDCAMA2) (FINDINGS 152)
+# The LDO ones are zte-ldo0..2 under mainline (leds-zte-ldo) and vddcama0..2_status of ZTE's zte_ldo_leds under
+# 5.4; the other GPIO LEDs in its device tree (net_red, net_green, net_white, pwr_green, wifi_*) light nothing,
+# under Android too.
+# The device comes from mu300-device; an LED this device has not is skipped.
+#
+# Timeout: /etc/mu300/led.conf, LED_TIMEOUT=SECONDS (0: always on). Default 60 on the U30 Air, which has a power
+# button to wake them, and 0 on the F50. What each LED should show is kept in /run/mu300/led, so a change while
+# the LEDs are dark shows up on the next wake.
+# Every write is best effort: the PMIC rejects a brightness write now and then (mobile-data), and a cosmetic
+# LED must never make a service fail.
+# (MU300_SYSROOT, MU300_BIN and MU300_LED_CONF are for tests/: a fake /, this directory, a led.conf)
+R=${MU300_SYSROOT:-}
+LEDS=$R/sys/class/leds
+STATE=$R/run/mu300/led
+DEVICE=$(${MU300_BIN:-/opt/mu300/bin}/mu300-device)
+
+# ZTE V50 (experimental; kano's mapping, read from its Android driver and lit one group at a time, FINDINGS 95): an
+#   AW9523B on I2C3 drives three lamps, each white, blue and red (mainline's leds-aw9523b, port/drivers/leds):
+#   the network LED is the lamp of the SIM in use, as ZTE's firmware (V50 B15, NotificationManagerService.setNetLight,
+#   read by kanoqwq; FINDINGS 199): logical slot 0 (SIM1: built-in card 1 or the external card) lights NET2, slot 1
+#   (SIM2: built-in card 2 or 3) NET1, blue on 4G, white on 5G, red without service; the other lamp stays dark. The
+#   slot is this boot's pin, /run/mu300/sim-slot, as the AT daemons read it. Wi-Fi white on 5 GHz, blue on 2.4 GHz.
+#   The PMIC's LEDs exist in its device tree as well, but are not its front panel: never written here. Under 5.4
+#   the V50 has no driver for them: every LED is skipped.
+BY_SIM=0
+V50_NET=net2
+[ "$(cat "$R/run/mu300/sim-slot" 2>/dev/null)" != 1 ] || V50_NET=net1
+case $DEVICE in
+    u30air) POWER=sc27xx:green DATA=net_blue DATA5G=zte-ldo0 NODATA=keyboard-backlight WIFI5=zte-ldo1 WIFI24=zte-ldo2
+            DEFAULT_TIMEOUT=60 BY_SIM=1 ;;   # DATA is slot 1's colour here, DATA5G slot 0's (BY_SIM)
+    v50)    POWER= DATA=v50:$V50_NET:blue DATA5G=v50:$V50_NET:white NODATA=v50:$V50_NET:red WIFI5=v50:wifi:white
+            WIFI24=v50:wifi:blue DEFAULT_TIMEOUT=0 ;;
+    *)      POWER= DATA=sc27xx:blue DATA5G=sc27xx:green NODATA=sc27xx:red WIFI5=keyboard-backlight
+            WIFI24=keyboard-backlight DEFAULT_TIMEOUT=0 ;;
+esac
+# the PMIC's RGB LED on both (the U30 Air's battery LED, the F50's network LED), one colour at a time: the white
+# outshines the others when mixed; the V50's network lamp
+SIREN="sc27xx:red sc27xx:green sc27xx:blue"
+[ "$DEVICE" != v50 ] || SIREN="v50:$V50_NET:red v50:$V50_NET:white v50:$V50_NET:blue"
+SIREN_PID=$R/run/mu300/led-siren.pid
+# the U30 Air's battery LED is the battery's (FINDINGS 151), not a "Linux is up" light any more: the three PMIC
+# channels are drawn by battery_show, never through the state files of the other LEDs
+BATTERY_LED=
+[ "$DEVICE" != u30air ] || { BATTERY_LED=1; POWER=; }
+PSY=$R/sys/class/power_supply
+TIMEOUT=$(sed -n 's/^LED_TIMEOUT=\([0-9][0-9]*\)$/\1/p' "${MU300_LED_CONF:-/etc/mu300/led.conf}" 2>/dev/null | tail -n1)
+TIMEOUT=${TIMEOUT:-$DEFAULT_TIMEOUT}
+# how often a key's "I heard that" flash blinks (LED_KEY_FLASH_COUNT in led.conf, default 2)
+KEY_FLASH_COUNT=$(sed -n 's/^LED_KEY_FLASH_COUNT=\([0-9][0-9]*\)$/\1/p' "${MU300_LED_CONF:-/etc/mu300/led.conf}" 2>/dev/null | tail -n1)
+case $KEY_FLASH_COUNT in ''|*[!0-9]*) KEY_FLASH_COUNT=2 ;; esac
+
+uptime_s() { cut -d. -f1 "$R/proc/uptime" 2>/dev/null || echo 0; }
+before() {  # before FILE: the uptime in FILE has not come yet
+    until=$(cat "$1" 2>/dev/null) || return 1
+    case $until in ''|*[!0-9]*) return 1 ;; esac
+    [ "$(uptime_s)" -lt "$until" ]
+}
+# on outside power (the U30 Air's charger) nothing times out, as under ZTE's firmware
+plugged() { [ "$(cat "$STATE/.plugged" 2>/dev/null)" = 1 ]; }
+awake() { [ "$TIMEOUT" = 0 ] || plugged || before "$STATE/.awake-until"; }
+vendor_ldo() {  # vendor_ldo zte-ldoN: the 5.4 kernel's switch for that LDO, if there
+    case $1 in zte-ldo[0-9]) ;; *) return 1 ;; esac
+    for f in "$R"/sys/devices/platform/*zte*ldo*leds*/vddcama${1#zte-ldo}_status; do [ -e "$f" ] && { echo "$f"; return 0; }; done
+    return 1
+}
+idle() { [ -e "$STATE/.idle" ]; }   # mu300-power's idle: dark, whatever the timeout
+# Lit now? Awake as usual; in idle only for a key's wake (.peek-until). The incident of 2026-10-07: idle on, and every
+# key press was swallowed by it - a device dark for hours that looked powered off. A key must always show life.
+shown() { if idle; then before "$STATE/.peek-until"; else awake; fi; }
+has_led() { [ -e "$LEDS/$1" ] || vendor_ldo "$1" >/dev/null; }
+level() {  # level NAME: its brightness when lit (ZTE lights the F50's Wi-Fi LED at 48: a low-current sink)
+    case $DEVICE:$1 in f50:keyboard-backlight) echo 48 ;; *) cat "$LEDS/$1/max_brightness" 2>/dev/null ;; esac
+}
+write() {  # write NAME 0|1|blink: the LED itself (blink: the timer trigger, 0.5 s on, 0.5 s off; steady without one)
+    if [ "$2" = blink ]; then
+        if [ -w "$LEDS/$1/trigger" ] && echo timer > "$LEDS/$1/trigger" 2>/dev/null; then
+            echo 500 > "$LEDS/$1/delay_on" 2>/dev/null
+            echo 500 > "$LEDS/$1/delay_off" 2>/dev/null
+            return 0
+        fi
+        set -- "$1" 1   # the 5.4 kernel's LDO switches: on or off
+    fi
+    if [ ! -e "$LEDS/$1" ] && f=$(vendor_ldo "$1"); then echo "$2" > "$f" 2>/dev/null; return 0; fi
+    [ -w "$LEDS/$1/brightness" ] || return 0
+    echo none > "$LEDS/$1/trigger" 2>/dev/null
+    if [ "$2" = 1 ]; then level "$1"; else echo 0; fi > "$LEDS/$1/brightness" 2>/dev/null
+    return 0
+}
+set_led() {  # set_led NAME 0|1|blink: what it should show; lit only while awake
+    [ -n "$1" ] || return 0
+    has_led "$1" || return 0
+    mkdir -p "$STATE" 2>/dev/null && echo "$2" > "$STATE/$1" 2>/dev/null
+    if [ "$2" != 0 ] && ! shown; then write "$1" 0; else write "$1" "$2"; fi
+}
+# The U30 Air's network LED by the SIM in use (FINDINGS 154). The slot is this boot's pin, the file the AT daemons
+# and mobile-data read too; it is never created here (that would pin a slot before mu300-atd chose one). A 1 counts
+# only where slot 1 is supported (the U30 Air on OpenWrt, as mu300-sim says): anywhere else every reader uses slot 0.
+sim_slot() {
+    s=$(cat "$R/run/mu300/sim-slot" 2>/dev/null)
+    if [ "$s" = 1 ] && [ -e "$R/etc/openwrt_release" ]; then echo 1; else echo 0; fi
+}
+sim_led() { if [ "$1" = 1 ]; then echo "$DATA"; else echo "$DATA5G"; fi; }   # sim_led SLOT: its colour
+network() {  # network NAME|'' VALUE: NAME shows VALUE, the network LED's other colours go dark
+    for l in "$NODATA" "$DATA" "$DATA5G"; do [ "$l" = "$1" ] || set_led "$l" 0; done
+    [ -z "$1" ] || set_led "$1" "$2"
+}
+# a live SIM switch's blink stays through the hang-up it causes (netifd tears the old connection down whenever it
+# gets to it): only while the switch is still under way, and only one that was announced here
+switching() { [ "$BY_SIM" = 1 ] && [ -e "$R/run/mu300/sim-switching" ] && [ -e "$STATE/.switch-to" ]; }
+wifi_band() {  # 5 or 2.4: the channel the hotspot runs on, else (it has none yet, just started) its setting
+    ch=$(iw dev wlan0 info 2>/dev/null | sed -n 's/.*channel \([0-9]*\).*/\1/p' | head -n1)
+    if [ -n "$ch" ]; then [ "$ch" -gt 14 ] && echo 5 || echo 2.4
+    else "${MU300_BIN:-/opt/mu300/bin}/mu300-wifi-band" 2>/dev/null | sed -n 's/^hotspot: \([0-9.]*\) GHz$/\1/p'; fi
+}
+# hostapd's access point on wlan0, as ubus has it: on while its object is there and not DISABLED (one still setting
+# up, ACS or a DFS wait, is on its way). iw is no help at that moment: when hostapd's object goes away, iw still
+# shows the SSID of the access point being torn down.
+hostapd_state() {
+    st=$(ubus call hostapd.wlan0 get_status 2>/dev/null | sed -n 's/.*"status": *"\([A-Z_]*\)".*/\1/p' | head -n1)
+    case $st in ''|DISABLED) echo off ;; *) echo on ;; esac
+}
+show_all() {  # every LED as it should be (none while idle, unless a key woke them)
+    battery_show
+    shown || return 0
+    for f in "$STATE"/*; do
+        [ -f "$f" ] || continue
+        write "${f##*/}" "$(cat "$f")"
+    done
+}
+siren_running() { p=$(cat "$SIREN_PID" 2>/dev/null) && [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }
+
+# --- the U30 Air's battery LED (FINDINGS 151): ZTE's services.jar ZteBatteryService and its lights HAL
+# ZTE's levels: white (the green channel) 120, blue 200, red 150 of 255
+battery_level() { case $1 in green) echo 120 ;; blue) echo 200 ;; red) echo 150 ;; esac; }
+# battery_read: "COLOUR MODE LOW PLUGGED" from the fuel gauge (mainline sc27xx-fgu, the 5.4 kernel's "battery") and
+# the charger (bq256xx-charger, or the 5.4 kernel's usb/ac); nothing without a capacity
+battery_read() {
+    _b=
+    for _d in "$PSY/sc27xx-fgu" "$PSY/battery"; do [ -r "$_d/capacity" ] && { _b=$_d; break; }; done
+    [ -n "$_b" ] || return 1
+    _cap=$(cat "$_b/capacity" 2>/dev/null); _st=$(cat "$_b/status" 2>/dev/null)
+    case $_cap in ''|*[!0-9]*) return 1 ;; esac
+    # outside power: the charger's online flag, when there is one. The gauge says "Charging" for a while after
+    # an unplug (kano saw it), so its status alone counts only where no charger says anything
+    _on=
+    for _d in "$PSY/bq256xx-charger" "$PSY/usb" "$PSY/ac"; do
+        _o=$(cat "$_d/online" 2>/dev/null) || continue
+        [ "$_o" = 1 ] && { _on=1; break; }
+        _on=0
+    done
+    [ -n "$_on" ] || case $_st in Charging|Full) _on=1 ;; *) _on=0 ;; esac
+    if [ "$_cap" -ge 60 ]; then _col=green; elif [ "$_cap" -ge 10 ]; then _col=blue; else _col=red; fi
+    _mode=steady; [ "$_on" = 1 ] && [ "$_st" = Charging ] && _mode=breathe
+    _low=0; [ "$_on" = 0 ] && [ "$_cap" -lt 10 ] && _low=1
+    echo "$_col $_mode $_low $_on"
+}
+# battery_show: the three channels as .battery says, lit while the LEDs are shown (and, below 10 % on the battery,
+# always); written only when that changes, so the breathing is not restarted every tick. The heat alarm's siren
+# owns the channels while it runs.
+battery_show() {
+    [ -n "$BATTERY_LED" ] || return 0
+    siren_running && return 0
+    _bc= _bm= _bl=
+    [ ! -r "$STATE/.battery" ] || read -r _bc _bm _bl < "$STATE/.battery"
+    _bw=off
+    if [ -n "$_bc" ] && [ ! -e "$STATE/.battery-off" ] && { [ "$_bl" = 1 ] || shown; }; then _bw="$_bc $_bm"; fi
+    [ "$_bw" != "$(cat "$STATE/.battery-shown" 2>/dev/null)" ] || return 0
+    for _c in red green blue; do
+        [ -w "$LEDS/sc27xx:$_c/brightness" ] || continue
+        if [ "$_bw" = "$_c steady" ]; then write_level "sc27xx:$_c" "$(battery_level $_c)"
+        elif [ "$_bw" = "$_c breathe" ]; then breathe "sc27xx:$_c" "$(battery_level $_c)"
+        else write "sc27xx:$_c" 0; fi
+    done
+    mkdir -p "$STATE" 2>/dev/null && echo "$_bw" > "$STATE/.battery-shown"
+}
+write_level() {  # write_level NAME LEVEL: steady at LEVEL
+    echo none > "$LEDS/$1/trigger" 2>/dev/null
+    echo "$2" > "$LEDS/$1/brightness" 2>/dev/null
+    return 0
+}
+# breathe NAME LEVEL: ZTE's charging light, 800 ms on and 1200 ms off, which its HAL hands the PMIC as a curve:
+# rise 2/5 of on, high 3/5, fall 2/5 of off, low 3/5 (the pattern trigger's hw_pattern); a timer blink without it
+# From a steady light the brightness goes to 0 first: the SC27xx's pattern_set sets RUN without clearing the steady
+# TYPE bit, and the pattern trigger's switch does not always call pattern_clear, so the LED stayed steady with both
+# bits set (kanoqwq read 0x300 in the PMIC's 0x180 on a U30 Air; 0x100 with this). A channel already on the pattern
+# trigger is left as it is.
+breathe() {
+    if grep -qw pattern "$LEDS/$1/trigger" 2>/dev/null; then
+        if ! grep -q '\[pattern\]' "$LEDS/$1/trigger" 2>/dev/null; then
+            echo 0 > "$LEDS/$1/brightness" 2>/dev/null
+            echo pattern > "$LEDS/$1/trigger" 2>/dev/null
+        fi
+        echo -1 > "$LEDS/$1/repeat" 2>/dev/null
+        echo "$2 320 $2 480 $2 480 $2 720" > "$LEDS/$1/hw_pattern" 2>/dev/null && return 0
+    fi
+    echo timer > "$LEDS/$1/trigger" 2>/dev/null
+    echo 800 > "$LEDS/$1/delay_on" 2>/dev/null
+    echo 1200 > "$LEDS/$1/delay_off" 2>/dev/null
+    echo "$2" > "$LEDS/$1/brightness" 2>/dev/null
+    return 0
+}
+# battery_update: read the battery, remember it, and show it. Unplugged: the timeout starts again from now (ZTE's
+# 15 s after an unplug; LED_TIMEOUT here); plugged in: everything lit, and it stays lit.
+battery_update() {
+    [ -n "$BATTERY_LED" ] || return 0
+    _now=$(battery_read) || return 0
+    mkdir -p "$STATE" 2>/dev/null || return 0
+    _was=$(cat "$STATE/.plugged" 2>/dev/null)
+    _p=${_now##* }
+    echo "$_p" > "$STATE/.plugged"
+    echo "${_now% *}" > "$STATE/.battery"
+    if [ "$_was" = 1 ] && [ "$_p" = 0 ] && [ "$TIMEOUT" != 0 ]; then
+        echo $(( $(uptime_s) + TIMEOUT )) > "$STATE/.awake-until"
+    fi
+    if [ "$_p" = 1 ] && [ "$_was" != 1 ]; then show_all; else battery_show; fi
+}
+nap() { sleep "$1" 2>/dev/null || sleep 1; }   # (a busybox without fractional sleep)
+
+case "$1 ${2:-}" in
+    "power on")   set_led "$POWER" 1; rm -f "$STATE/.battery-off"; battery_update
+                  [ "$TIMEOUT" = 0 ] || idle || exec "$0" wake ;;   # (a boot, not a key)
+    "power off")  set_led "$POWER" 0
+                  [ -z "$BATTERY_LED" ] || { mkdir -p "$STATE" 2>/dev/null; : > "$STATE/.battery-off"; battery_show; } ;;
+    "battery "*)  battery_update ;;
+    "tick "*)     battery_update; exec "$0" sleep --if-due ;;
+    "data on"|"data 5g")
+        rm -f "$STATE/.switch-to"
+        if [ "$BY_SIM" = 1 ]; then network "$(sim_led "$(sim_slot)")" 1
+        elif [ "$2" = 5g ]; then network "$DATA5G" 1
+        else network "$DATA" 1; fi ;;
+    "data off"|"data error")
+        switching && exit 0
+        rm -f "$STATE/.switch-to"
+        if [ "$2" = error ]; then network "$NODATA" 1; else network '' 0; fi ;;
+    "data switching")
+        [ "$BY_SIM" = 1 ] || exit 0   # (no other device switches SIMs live)
+        case ${3:-} in 0|1) ;; *) echo "mu300-led data switching: the slot is 0 or 1" >&2; exit 2 ;; esac
+        mkdir -p "$STATE" 2>/dev/null && echo "$3" > "$STATE/.switch-to" 2>/dev/null
+        network "$(sim_led "$3")" blink ;;
+    "wifi on")
+        if [ "$WIFI5" = "$WIFI24" ]; then set_led "$WIFI5" 1
+        elif [ "$(wifi_band)" = 5 ]; then set_led "$WIFI24" 0; set_led "$WIFI5" 1
+        else set_led "$WIFI5" 0; set_led "$WIFI24" 1; fi ;;
+    "wifi off")   set_led "$WIFI5" 0; [ "$WIFI24" = "$WIFI5" ] || set_led "$WIFI24" 0 ;;
+    "wifi sync")  # a running AP has its SSID in iw's answer; a stopped hostapd leaves "type AP" without one
+        # (a hotspot that LuCI turned on can take longer than any one moment to come up: S follows it a while)
+        n=${3:-0} last=
+        case $n in ''|*[!0-9]*) n=0 ;; esac
+        while :; do
+            if iw dev wlan0 info 2>/dev/null | grep -q '^[[:space:]]*type AP' &&
+               iw dev wlan0 info 2>/dev/null | grep -q '^[[:space:]]*ssid '; then s=on; else s=off; fi
+            [ "$s" = "$last" ] || { "$0" wifi "$s"; last=$s; }
+            [ "$n" -gt 0 ] || break
+            nap 2; n=$((n - 2))
+        done ;;
+    "events "*)
+        # ubusd announces every object it adds and removes, and hostapd.wlan0 is there exactly while hostapd runs
+        # the access point. The state is read once the listener is up (nothing in between is missed), then at each
+        # of its events. The data LED stays mobile-data's (the dial, the hang-up, its watchdog).
+        command -v ubus >/dev/null 2>&1 || { echo "mu300-led events: needs ubus (OpenWrt)" >&2; exit 1; }
+        ubus listen ubus.object.add ubus.object.remove | {
+            last=$(hostapd_state); "$0" wifi "$last"
+            while IFS= read -r ev; do
+                case $ev in *'"hostapd.wlan0"'*) ;; *) continue ;; esac
+                s=$(hostapd_state)
+                [ "$s" = "$last" ] || { "$0" wifi "$s"; last=$s; }
+            done
+        } ;;
+    "wake "*)
+        mkdir -p "$STATE" 2>/dev/null
+        now=$(uptime_s)
+        if idle; then   # idle: lit for the timeout all the same (a minute where there is none), then dark again
+            t=$TIMEOUT; [ "$t" != 0 ] || t=60
+            echo $((now + t)) > "$STATE/.peek-until"
+        fi
+        [ "$TIMEOUT" = 0 ] || echo $((now + TIMEOUT)) > "$STATE/.awake-until"
+        show_all ;;
+    "sleep "*)
+        if idle; then   # a key's wake in idle: dark again once it is over
+            if [ "${2:-}" = --if-due ] && shown; then exit 0; fi
+            [ -e "$STATE/.peek-until" ] || [ "${2:-}" != --if-due ] || exit 0   # dark already
+            rm -f "$STATE/.peek-until"
+        else
+            [ "$TIMEOUT" = 0 ] && exit 0
+            if [ "${2:-}" = --if-due ] && awake; then exit 0; fi
+            [ -e "$STATE/.awake-until" ] || [ "${2:-}" != --if-due ] || exit 0   # dark already
+        fi
+        rm -f "$STATE/.awake-until"
+        for f in "$STATE"/*; do [ -f "$f" ] && write "${f##*/}" 0; done
+        battery_show ;;
+    "idle on")
+        mkdir -p "$STATE" 2>/dev/null
+        : > "$STATE/.idle"
+        rm -f "$STATE/.peek-until"
+        for f in "$STATE"/*; do [ -f "$f" ] && write "${f##*/}" 0; done
+        [ -z "$POWER" ] || write "$POWER" 0
+        battery_show ;;
+    "idle off")
+        rm -f "$STATE/.idle" "$STATE/.peek-until"
+        if awake; then show_all; fi ;;   # past the timeout they stay dark until the next wake
+    "charge on")
+        # the U30 Air: its battery LED breathes while it charges anyway (battery_update)
+        [ -z "$BATTERY_LED" ] || { battery_update; exit 0; }
+        [ -n "$POWER" ] && [ -w "$LEDS/$POWER/trigger" ] || exit 0
+        echo timer > "$LEDS/$POWER/trigger" 2>/dev/null
+        echo 1000 > "$LEDS/$POWER/delay_on" 2>/dev/null
+        echo 1000 > "$LEDS/$POWER/delay_off" 2>/dev/null ;;
+    "charge off")
+        [ -z "$BATTERY_LED" ] || { battery_update; exit 0; }
+        [ -n "$POWER" ] && [ -w "$LEDS/$POWER/trigger" ] || exit 0
+        echo none > "$LEDS/$POWER/trigger" 2>/dev/null
+        write "$POWER" 0
+        if awake; then show_all; fi ;;
+    "alarm on")
+        siren_running && exit 0
+        mkdir -p "${SIREN_PID%/*}" 2>/dev/null
+        "$0" siren </dev/null >/dev/null 2>&1 &
+        echo $! > "$SIREN_PID" ;;
+    "alarm off")
+        siren_running || { rm -f "$SIREN_PID"; exit 0; }
+        kill "$p" 2>/dev/null
+        rm -f "$SIREN_PID"
+        nap 0.2
+        for l in $SIREN; do write "$l" 0; done
+        rm -f "$STATE/.battery-shown"    # the siren drew over it
+        show_all ;;   # the U30 Air's white is its power LED, the F50's colours its network LED
+    "siren "*)   # (alarm on runs this in the background)
+        # Only the siren named in the pid file runs: one left behind (its alarm switched off while it was
+        # between writes, a restarted service) stops by itself instead of flashing along with the new one.
+        # The file is written just after the start, so a missing one counts only after the first round.
+        n=0
+        while :; do
+            own=$(cat "$SIREN_PID" 2>/dev/null)
+            if [ -n "$own" ]; then [ "$own" = $$ ] || exit 0
+            elif [ $n -gt 0 ]; then exit 0; fi
+            n=$((n + 1))
+            for on in $SIREN; do
+                for l in $SIREN; do [ "$l" = "$on" ] || write "$l" 0; done
+                write "$on" 1; nap 0.25
+            done
+        done ;;
+    "flash "*)   # a key acted: say so while the change it made is still on its way (a band switch reloads
+        # Wi-Fi, which takes seconds, and the colour that answers for it comes with the new channel).
+        # Only the V50 has one lamp carrying every state, so only it has a colour to flash.
+        [ "$DEVICE" = v50 ] || exit 0
+        shown || exit 0   # dark is dark: a flash is not a reason to light a device that is meant to be dark
+        _fl=
+        for l in "$NODATA" "$DATA" "$DATA5G"; do
+            [ -n "$l" ] || continue
+            [ "$(cat "$STATE/$l" 2>/dev/null)" = 1 ] && { _fl=$l; break; }
+        done
+        [ -n "$_fl" ] || exit 0
+        _fi=0
+        while [ "$_fi" -lt "$KEY_FLASH_COUNT" ]; do
+            write "$_fl" 0; nap 0.15
+            write "$_fl" 1; nap 0.15
+            _fi=$((_fi + 1))
+        done ;;
+    "test "*)
+        for l in "$LEDS"/*; do
+            n=${l##*/}
+            case $DEVICE:$n in *:mmc*) continue ;; f50:keyboard-backlight) ;; *:*backlight*) continue ;; v50:sc27xx:*) continue ;; esac
+            old=$(cat "$l/brightness" 2>/dev/null)
+            echo "$n"; write "$n" 1; sleep 2; echo "${old:-0}" > "$l/brightness" 2>/dev/null
+        done ;;
+    *) sed -n '2,24s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
+esac
+exit 0
diff --git a/openwrt/vendor-extra/opt/mu300/bin/mu300-wifi-band b/openwrt/vendor-extra/opt/mu300/bin/mu300-wifi-band
new file mode 100755
index 0000000..dfd91d2
--- /dev/null
+++ b/openwrt/vendor-extra/opt/mu300/bin/mu300-wifi-band
@@ -0,0 +1,65 @@
+#!/bin/sh
+# The hotspot's band (Ubuntu and OpenWrt). The chip runs one access point at a time, on 2.4 or on 5 GHz.
+#   mu300-wifi-band            show it
+#   mu300-wifi-band 2.4|5      switch to that band and restart the hotspot (kept across reboots)
+#   mu300-wifi-band toggle     the other one (the U30 Air's Wi-Fi key, see mu300-buttons)
+# The channel goes back to automatic: 5 GHz channels mean nothing on 2.4 GHz and the other way round.
+# Ubuntu: BAND and CHANNEL in /etc/mu300/hotspot.conf (hotspot-start). OpenWrt: wireless.radio0 in UCI, on 5 GHz the
+# country's default channel without DFS and its channel list for auto (lib/wifi-channels.sh: no radar detection).
+# (MU300_HOTSPOT_CONF, MU300_SYSROOT and MU300_WIFI_CHANNELS are for tests/)
+CONF=${MU300_HOTSPOT_CONF:-/etc/mu300/hotspot.conf}
+WIFI_CHANNELS=${MU300_WIFI_CHANNELS:-/opt/mu300/lib/wifi-channels.sh}
+[ -r "$WIFI_CHANNELS" ] || WIFI_CHANNELS=$(dirname "$0")/../lib/wifi-channels.sh
+. "$WIFI_CHANNELS"
+is_openwrt() { [ -e "${MU300_SYSROOT:-}/etc/openwrt_release" ] && [ -z "${MU300_HOTSPOT_CONF:-}" ]; }
+
+current() {
+    if is_openwrt; then
+        case $(uci -q get wireless.radio0.band) in 2g) echo 2.4 ;; *) echo 5 ;; esac
+    elif [ ! -r "$CONF" ] && ch=$(iw dev wlan0 info 2>/dev/null | sed -n 's/.*channel \([0-9]*\).*/\1/p') && [ -n "$ch" ]; then
+        # the file holds the passphrase and only root reads it: the channel the hotspot runs on tells too
+        [ "$ch" -gt 14 ] && echo 5 || echo 2.4
+    else
+        case $(sed -n 's/^BAND=//p' "$CONF" 2>/dev/null | head -n1) in 2.4) echo 2.4 ;; *) echo 5 ;; esac
+    fi
+}
+
+set_band() {  # set_band 2.4|5
+    if is_openwrt; then
+        if [ "$1" = 2.4 ]; then
+            b=2g ch=6 ht=HT20
+            chl='delete wireless.radio0.channels
+delete wireless.radio0.acs_exclude_dfs'
+        else
+            cc=$(uci -q get wireless.radio0.country); cc=${cc:-TR}
+            ch=$(wifi_ap5_default "$cc")
+            [ -n "$ch" ] || { echo "no 5 GHz channel without DFS in country $cc: the hotspot stays on 2.4 GHz" >&2; exit 1; }
+            b=5g ht=VHT$(wifi_ap5_width "$cc" "$ch")
+            chl="set wireless.radio0.channels='$(wifi_ap5_channels "$cc")'
+set wireless.radio0.acs_exclude_dfs='1'"
+        fi
+        uci -q batch <<UCI
+set wireless.radio0.band='$b'
+set wireless.radio0.channel='$ch'
+set wireless.radio0.htmode='$ht'
+$chl
+commit wireless
+UCI
+        wifi reload >/dev/null 2>&1 &
+    else
+        [ -f "$CONF" ] || { echo "no $CONF (the hotspot has not run yet)" >&2; exit 1; }
+        # the file holds the passphrase: rewrite its contents in place, keeping its owner and mode
+        for k in BAND CHANNEL; do grep -q "^$k=" "$CONF" || echo "$k=" >> "$CONF"; done
+        new=$(sed -e "s/^BAND=.*/BAND=$1/" -e 's/^CHANNEL=.*/CHANNEL=auto/' "$CONF") && printf '%s\n' "$new" > "$CONF"
+        [ -n "${MU300_HOTSPOT_CONF:-}" ] || systemctl restart mu300-hotspot >/dev/null 2>&1 &
+    fi
+    echo "hotspot: $1 GHz"
+}
+
+case ${1:-} in
+    '') echo "hotspot: $(current) GHz" ;;
+    2.4|2|2g) set_band 2.4 ;;
+    5|5g) set_band 5 ;;
+    toggle) if [ "$(current)" = 5 ]; then set_band 2.4; else set_band 5; fi ;;
+    *) echo "usage: mu300-wifi-band [2.4|5|toggle]" >&2; exit 2 ;;
+esac
diff --git a/openwrt/vendor-extra/usr/libexec/unisoc-modem/dashboard-info b/openwrt/vendor-extra/usr/libexec/unisoc-modem/dashboard-info
new file mode 100755
index 0000000..0a82baa
--- /dev/null
+++ b/openwrt/vendor-extra/usr/libexec/unisoc-modem/dashboard-info
@@ -0,0 +1,504 @@
+#!/bin/sh
+# mu300-dash-info -- the dashboard's system/network snapshot: ONE line of JSON on stdout.
+#
+# The LuCI home page (luci-app-mu300) polls this through the rpcd backend
+# /usr/libexec/rpcd/mu300dash every few seconds. It reads only files and asks
+# ubus/uci/iw, so it never touches the modem's AT channel - the cell readings
+# live in mu300-dash-cell, which has its own cache and its own pace.
+#
+# CPU time and interface byte counters are "since boot" cumulative values; the
+# page subtracts two consecutive snapshots to get CPU% and live rates, so the
+# poll interval never skews the numbers.
+#
+# Every external call is wrapped in a hard timeout: netifd mid-reload or a wedged
+# driver must not void the whole snapshot (the same lesson the V50 panel learned
+# in the field - one hung call used to blank every readout on the page).
+#
+# Known traps this deliberately works around (docs/FINDINGS.md and the V50
+# research archive):
+#   * loadavg is meaningless here - three vendor kernel threads sit in D state
+#     and pin it around 3.5 forever. It is not reported at all.
+#   * iw/iwinfo never report tx-power or a sane channel on the sprd WCN driver;
+#     SSID/channel come from uci instead.
+#   * thermal zones are matched by type, never by zone number.
+
+export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/libexec/unisoc-modem:/usr/sbin:/sbin"
+# the shared JSON escaper and uci allow-lists (/usr/share/unisoc-modem/lib.sh)
+LIB=${0%/*}/../../share/unisoc-modem/lib.sh
+[ -f "$LIB" ] || LIB=/usr/share/unisoc-modem/lib.sh
+. "$LIB"
+
+BB=/opt/mu300/bin/busybox
+[ -x "$BB" ] || BB=busybox
+t3() { "$BB" timeout -s KILL 3 "$@" 2>/dev/null; }   # external asks: netifd, uci, iw...
+t2() { "$BB" timeout -s KILL 2 "$@" 2>/dev/null; }
+
+rd() { cat "$1" 2>/dev/null; }
+# numbers and strings through the shared helpers (lib.sh): host names, SSIDs
+# and the APN come from other people's devices and from uci
+n_or_null() { json_num "$1"; }
+f_or_null() { json_num "$1"; }
+qs() { json_str_or_null "$1"; }
+
+# ------------------------------------------------------------- temperature
+# type -> label, the four zones this SoC actually has; hottest covers the rest
+temp_of() {
+    local z t
+    for z in /sys/class/thermal/thermal_zone*; do
+        [ -r "$z/type" ] || continue
+        [ "$(rd "$z/type")" = "$1" ] || continue
+        t=$(rd "$z/temp")
+        [ -n "$t" ] || return 0
+        awk -v v="$t" 'BEGIN{printf "%.1f", v/1000}'
+        return 0
+    done
+}
+temp_hottest() {
+    rd /sys/class/thermal/thermal_zone*/temp 2>/dev/null | sort -n | tail -n1 | awk '{printf "%.1f", $1/1000}'
+}
+
+# ------------------------------------------------------- a ubus scalar field
+# the ubus CLI pretty-prints with spaces, so sed on the literal key; first match
+# wins (the fields used here appear once, ipv4 before ipv6 in the address blocks)
+jval() { printf '%s' "$1" | sed -n "s/.*\"$2\": *\"\{0,1\}\([^,\"}\]*\).*/\1/p" | head -n1; }
+
+# ----------------------------------------------------------------- WAN (ubus)
+# the UI can write these options: interface names only (they become ubus
+# object names, /sys paths and uci keys), else the defaults
+cfg() { uci_get "$1"; }
+DATA_IFACE=$(safe_iface "$(cfg data_interface)" wan)
+DATA_IFACE6=$(safe_iface "$(cfg data_interface_v6)" wan6)
+WANJSON=$(t3 ubus call "network.interface.$DATA_IFACE" status)
+WAN6JSON=$(t3 ubus call "network.interface.$DATA_IFACE6" status)
+SIM_SLOT=0
+# The SIM selector's own account, for the pages (issue #194): "slot" the card this boot uses, "wanted" the one the
+# configuration asks for, "slot1_supported" whether this device has the internal card at all. mu300-sim falls back to
+# slot 0 on a device without slot 1, and nothing said so: the home page and the interface page read it from here.
+# Local only (uci and a file under /run): no AT command. null without the selector, when status fails, or when
+# the U30 transaction reports active:null. A pinned routing slot is not proof of an observed active card.
+SIMBIN=${MU300_SIM_BIN:-/opt/mu300/bin/mu300-sim}
+SIM_JSON=null
+if [ -x "$SIMBIN" ]; then
+    SIM_SLOT=$("$SIMBIN" active) || exit 1
+    sim_status=$("$SIMBIN" status --json 2>/dev/null)
+    sim_n() { printf '%s\n' "$sim_status" | sed -n "s/.*\"$1\": *\([0-9]\).*/\1/p" | head -n1; }
+    sim_active=$(sim_n active); sim_wanted=$(sim_n default); sim_s1=$(sim_n slot1_supported)
+    case "$sim_active$sim_wanted$sim_s1" in
+        [12][12][01]) SIM_JSON="{\"slot\":$((sim_active - 1)),\"wanted\":$((sim_wanted - 1)),\"slot1_supported\":$sim_s1}" ;;
+    esac
+    # the ZTE V50 (FINDINGS 204): slot 0 is built-in SIM 1 or the external SIM, slot 1 built-in SIM 2 or 3
+    case $SIM_JSON:$sim_status in '{'*:*'"v50":{'*) SIM_JSON="${SIM_JSON%\}},\"v50\":1}" ;; esac
+fi
+# The mobile data device: the one netifd's WAN uses now (its l3_device) first, the configured one (data_device) while the
+# WAN has none, the slot's CID 1 bearer last. A configured name used to win over the live one, so a WAN on another
+# device (another CID, the other card's bearer after a live switch) was counted on the wrong interface.
+DATA_DEVICE=$(safe_iface "$(jval "$WANJSON" l3_device)" '')
+[ -n "$DATA_DEVICE" ] || DATA_DEVICE=$(safe_iface "$(cfg data_device)" '')
+[ -n "$DATA_DEVICE" ] || DATA_DEVICE=sipa_eth$((SIM_SLOT * 8))
+LAN_DEVICE=$(safe_iface "$(cfg lan_device)" br-lan)
+WIFI_DEVICE=$(safe_iface "$(cfg wifi_device)" wlan0)
+USB_DEVICE=$(safe_iface "$(cfg usb_device)" usb0)
+# The gadget netdev is usb0 in NCM/ECM mode and rndis0 in RNDIS mode (see boot/init
+# setup_usb_gadget). Neither the uci option nor the fallback above names that, so with RNDIS
+# selected this read a device that does not exist, net_obj returned null, and the status
+# dashboard reported the USB network as "Disconnected" while the link was up. (V50, 2026-10-10)
+if [ ! -d "/sys/class/net/$USB_DEVICE" ]; then
+	for _c in usb0 rndis0; do
+		[ -d "/sys/class/net/$_c" ] && { USB_DEVICE=$_c; break; }
+	done
+fi
+jaddr4() { printf '%s' "$1" | sed -n 's/.*"address": *"\([^"]*\)".*/\1/p' | head -n1; }
+# The active DNS servers of the data interfaces. ubus pretty-prints the array over several lines, so it is read with
+# jsonfilter: the top-level "dns-server" only (never inactive.dns-server), IPv4 and IPv6 status alike, each server
+# once. Based on kanoqwq/mu300-linux@5c8c2f9.
+wan_dns_servers() {
+    local snapshot
+    for snapshot in "$@"; do
+        [ -n "$snapshot" ] || continue
+        jsonfilter -s "$snapshot" -e '@["dns-server"][*]' 2>/dev/null || :
+    done | awk 'NF && !seen[$0]++ { printf "%s%s", sep, $0; sep = ", " }'
+}
+
+wan_up=$(jval "$WANJSON" up)
+[ "$wan_up" = "true" ] && wan_up=1 || wan_up=0
+wan_uptime=$(jval "$WANJSON" uptime)
+wan_proto=$(jval "$WANJSON" proto)
+wan_ip4=$(jaddr4 "$WANJSON")
+wan6_up=$(jval "$WAN6JSON" up)
+[ "$wan6_up" = "true" ] && wan6_up=1 || wan6_up=0
+wan6_ip=$(t2 ip -6 addr show "$DATA_DEVICE" 2>/dev/null | awk '/inet6 [23]/{split($2,s,"/"); print s[1]; exit}')
+wan_dns=$(wan_dns_servers "$WANJSON" "$WAN6JSON")
+# slot 1 (the F50's internal card) has its own APN option, see mu300cell.sh
+apn_option=apn
+[ "$SIM_SLOT" != 1 ] || apn_option=apn_internal
+apn=$(t3 uci -q get "network.$DATA_IFACE.$apn_option")
+[ -n "$apn" ] || apn="(SIM default)"
+# data roaming (mobile-data, docs/FINDINGS.md 120): the card's setting - unset or anything but a "no" is allowed, as
+# the dial reads it - and whether data is held back because the card is registered as roaming
+roam_option=roaming
+[ "$SIM_SLOT" != 1 ] || roam_option=roaming_internal
+case $(t3 uci -q get "network.$DATA_IFACE.$roam_option") in 0|off|no|false) roam_allowed=0 ;; *) roam_allowed=1 ;; esac
+roam_held=0
+[ ! -e "${MU300_ROAM_HELD:-/run/mu300/data-roaming-held}" ] || roam_held=1
+
+# ------------------------------------------------------------------- system
+NOW=$(date +%s)
+UPTIME=$(cut -d' ' -f1 /proc/uptime | cut -d. -f1)
+HOST=$(t3 uci -q get system.@system[0].hostname)
+[ -n "$HOST" ] || HOST=$(rd /proc/sys/kernel/hostname)
+MODEL=$(rd /tmp/sysinfo/model 2>/dev/null)
+[ -n "$MODEL" ] || MODEL=$(rd /proc/device-tree/model 2>/dev/null | tr -d '\0')
+FW=$(sed -n "s/^DISTRIB_DESCRIPTION='\(.*\)'$/\1/p" /etc/openwrt_release 2>/dev/null)
+[ -n "$FW" ] || FW=$(uname -sr)
+
+# /proc/stat first line: cpu user nice system idle iowait irq softirq steal ...
+# busy = everything except idle+iowait; the page deltas this against the last poll
+read -r _cpu _u _n _s _i _w _irq _sirq _st _rest < /proc/stat
+CPU_TOTAL=$(( _u + _n + _s + _i + _w + _irq + _sirq + _st ))
+CPU_IDLE=$(( _i + _w ))
+CPUN=$(grep -c '^processor' /proc/cpuinfo)
+# one freq pair per policy (big.LITTLE shows two; the page averages or shows both)
+FREQS=
+for p in /sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq; do
+    [ -r "$p" ] || continue
+    d=$(dirname "$p")
+    FREQS="$FREQS{\"cur\":$(n_or_null "$(rd "$p")"),\"max\":$(n_or_null "$(rd "$d/cpuinfo_max_freq")")},"
+done
+FREQS=${FREQS%,}
+
+MEM_T=$(awk '/^MemTotal/{print $2}' /proc/meminfo)
+MEM_A=$(awk '/^MemAvailable/{print $2}' /proc/meminfo)
+
+# df on / (the ext4 mu300root loop device)
+DF=$(df -k / 2>/dev/null | awk 'NR==2{print $2, $3, $4}')
+set -- $DF; DISK_T=$1; DISK_U=$2; DISK_A=$3
+
+T_SOC=$(temp_of soc-thmzone)
+T_CPU=$(temp_of apcpu0-thmzone)
+T_NR=$(temp_of nr0-thmzone)
+T_BRD=$(temp_of board-thmzone)
+T_HOT=$(temp_hottest)
+
+# ------------------------------------------------------------------- power
+# Only the U30 Air has a battery (the F50 and the V50 have none). Its fuel gauge is "battery" under 5.4 (the
+# vendor charger manager) and "sc27xx-fgu" under mainline (UMP9620, FINDINGS
+# 33d); any other supply of type Battery is taken after those. The F50 has
+# none, but the same PMIC: under mainline its fuel gauge appears with made-up
+# values, so an F50 reports no battery and the page hides the tile.
+# voltage_now is microvolts, current_now microamps: positive into the battery
+# under mainline (the status comes from bq256xx-charger, patch 0010; without
+# it patch 0006 derives "Charging" from current > 20 mA); the page goes by
+# status first, the sign only for Unknown and the like. An install
+# whose ramdisk does not name the device reads as an F50 under mainline (no
+# charger_policy_service in that device tree): no tile, never a wrong one. The
+# charger (5.4: "usb"/"ac") says whether external power is on and, where it
+# exposes them, the input voltage and current; mainline: bq256xx-charger (online only).
+PSY=${MU300_POWER_SUPPLY_DIR:-/sys/class/power_supply}
+P_DIR=
+case $(mu300-device 2>/dev/null) in f50|v50) ;; *)
+    for d in "$PSY/battery" "$PSY/sc27xx-fgu" "$PSY"/*; do
+        [ -d "$d" ] || continue
+        [ "$(rd "$d/present")" = 0 ] && continue
+        case ${d##*/} in
+            battery|sc27xx-fgu) [ -r "$d/capacity" ] || [ "$(rd "$d/type")" = Battery ] || continue ;;
+            *) [ "$(rd "$d/type")" = Battery ] || continue ;;
+        esac
+        P_DIR=$d; break
+    done
+    ;; esac
+P_PRESENT=0 P_CAP= P_STATUS= P_V= P_I= P_USB= P_IN_V= P_IN_I=
+if [ -n "$P_DIR" ]; then
+    P_PRESENT=1
+    P_CAP=$(rd "$P_DIR/capacity")
+    P_STATUS=$(rd "$P_DIR/status")
+    P_V=$(rd "$P_DIR/voltage_now")
+    P_I=$(rd "$P_DIR/current_now")
+    # the first USB/Mains supply that is online, else whether any says 0
+    for d in "$PSY"/*; do
+        case $(rd "$d/type") in USB*|Mains) ;; *) continue ;; esac
+        o=$(rd "$d/online")
+        case $o in 1) ;; 0) P_USB=0; continue ;; *) continue ;; esac
+        P_USB=1
+        P_IN_V=$(rd "$d/voltage_now")
+        P_IN_I=$(rd "$d/current_now")
+        [ -n "$P_IN_I" ] || P_IN_I=$(rd "$d/input_current_now")
+        break
+    done
+fi
+case "$P_CAP" in ''|*[!0-9]*) P_CAP= ;; esac
+# volts with two decimals, microamps as an integer, watts = |V x I| with two
+power_v() { awk -v v="$1" 'BEGIN{if(v ~ /^-?[0-9]+$/ && v+0>0)printf "%.2f",v/1000000}'; }
+power_i() { awk -v v="$1" 'BEGIN{if(v ~ /^-?[0-9]+$/)printf "%d",v}'; }
+power_w() { awk -v v="$1" -v i="$2" 'BEGIN{if(v ~ /^-?[0-9]+$/ && i ~ /^-?[0-9]+$/ && v+0>0){w=v*i/1e12; if(w<0)w=-w; printf "%.2f",w}}'; }
+P_W=$(power_w "$P_V" "$P_I")
+P_IN_W=$(power_w "$P_IN_V" "$P_IN_I")
+P_V=$(power_v "$P_V"); P_I=$(power_i "$P_I")
+P_IN_V=$(power_v "$P_IN_V"); P_IN_I=$(power_i "$P_IN_I")
+
+# ------------------------------------------------------- interface counters
+net_obj() {  # net_obj IFACE -> {"rx":N,"tx":N,"up":0|1} or null
+    # an interface name by safe_iface's rule, or nothing is read: the name becomes a /sys path
+    [ -n "$1" ] && [ "$(safe_iface "$1" '')" = "$1" ] || { echo null; return; }
+    local d=/sys/class/net/$1
+    [ -d "$d" ] || { echo null; return; }
+    local rx tx up
+    rx=$(rd "$d/statistics/rx_bytes"); tx=$(rd "$d/statistics/tx_bytes")
+    case "$(rd "$d/operstate")" in up) up=1 ;; *) up=0 ;; esac
+    printf '{"rx":%s,"tx":%s,"up":%d}' "$(n_or_null "$rx")" "$(n_or_null "$tx")" "$up"
+}
+
+# ------------------------------------------------------------------- Wi-Fi
+# configuration truth is uci (the driver reports nothing useful); per-client detail
+# comes from the driver's station table, names and addresses from the DHCP leases.
+# ONE "uci show wireless" instead of nine "uci get": each uci call costs a fork
+# plus config parse and they added up to most of this script's runtime.
+WSHOW=$(t3 uci -q show wireless 2>/dev/null)
+wu() {  # wu KEY -> value ('' when absent); KEY like "radio0.channel"
+    printf '%s\n' "$WSHOW" | sed -n "s/^wireless\\.$1='\\(.*\\)'$/\\1/p" | head -n1
+}
+# anonymous sections appear in "uci show" under their cfg id, and named ones use
+# their name - either way the section type line has no quotes; resolve the first
+# wifi-iface section once and read its options through that key
+IFKEY=$(printf '%s\n' "$WSHOW" | sed -n "s/^wireless\\.\\([^.]*\\)=wifi-iface\$/\\1/p" | head -n1)
+W_SSID=$(wu "${IFKEY:-x}.ssid")
+W_CH=$(wu 'radio0.channel')
+W_BAND=$(wu 'radio0.band')
+[ -n "$W_BAND" ] || W_BAND=$(wu 'radio0.hwmode')
+W_HT=$(wu 'radio0.htmode')   # HE80 / VHT40 / HT20 -> the number is the width
+W_WIDTH=$(printf '%s' "$W_HT" | tr -cd '0-9' | head -c 2)
+[ -n "$W_WIDTH" ] && W_WIDTH="$W_WIDTH MHz"
+W_COUNTRY=$(wu 'radio0.country')
+W_ENC=$(wu "${IFKEY:-x}.encryption")
+[ -n "$W_ENC" ] || W_ENC=none
+W_HIDDEN=$(wu "${IFKEY:-x}.hidden")
+W_HOSTAPD=0
+HAPD=$(t3 ubus call "hostapd.$WIFI_DEVICE" get_status 2>/dev/null)
+printf '%s' "$HAPD" | grep -q '"status": *"ENABLED"' && W_HOSTAPD=1
+W_DIS=$(wu 'radio0.disabled')
+[ "$W_DIS" = "1" ] && W_UP=0 || W_UP=1
+[ -d "/sys/class/net/$WIFI_DEVICE" ] || W_UP=0
+[ "$W_HOSTAPD" = 1 ] || W_UP=0
+# station table: one block per client - mac, signal, tx/rx bitrate, connected time. A row is written when its block
+# ends (the signal line comes before the bitrates and the connected time), and a client the SC2355 driver reports
+# without metrics still counts. dnsmasq's leases file holds the MAC in lower case and "*" for a client that sent no
+# name. Based on kanoqwq/mu300-linux@373e191.
+LEASES_FILE=${MU300_DHCP_LEASES:-/tmp/dhcp.leases}
+station_rows() {
+    awk '
+    function emit(   a, n, i) {
+        n = split(mac, a, ":")
+        if (n != 6) return
+        for (i = 1; i <= n; i++)
+            if (a[i] !~ /^[0-9a-f][0-9a-f]$/) return
+        if (seen[mac]++) return
+        printf "%s|%s|%s|%s|%s\n", mac, sig, tx, rx, ct
+    }
+    /^Station[ \t]+/ { emit(); mac = tolower($2); sig = tx = rx = ct = ""; next }
+    /^[ \t]+signal:/ && $2 ~ /^-?[0-9]+([.][0-9]+)?$/ && $2 + 0 != 0 { sig = $2 + 0 }
+    /^[ \t]+tx bitrate:/ && $3 ~ /^[0-9]+([.][0-9]+)?$/ { tx = $3 " Mbit/s" }
+    /^[ \t]+rx bitrate:/ && $3 ~ /^[0-9]+([.][0-9]+)?$/ { rx = $3 " Mbit/s" }
+    /^[ \t]+connected time:/ && $3 ~ /^[0-9]+$/ { ct = sprintf("%d min", int($3 / 60)) }
+    END { emit() }'
+}
+W_CLIENTS=$(t3 iw dev "$WIFI_DEVICE" station dump 2>/dev/null | station_rows)
+# SC2355's "station dump" lists only each MAC (and the time); "station get MAC" has the metrics (measured on the U30
+# Air: "rx bitrate: 144.4 MBit/s", "signal: 0 dBm", "tx bitrate: (unknown)"). So a row without them asks once per
+# listed client, at most 16, 2 s each; a field that stays unknown (signal 0, "(unknown)", no connected time) is null.
+# The MAC was checked to be six hex pairs by station_rows, so it reaches iw as one plain argument.
+station_fill() {
+    local mac sig tx rx ct g asked=0
+    while IFS='|' read -r mac sig tx rx ct; do
+        [ -n "$mac" ] || continue
+        if { [ -z "$sig" ] || [ -z "$tx" ] || [ -z "$rx" ] || [ -z "$ct" ]; } && [ "$asked" -lt 16 ]; then
+            asked=$((asked + 1))
+            g=$(t2 iw dev "$WIFI_DEVICE" station get "$mac" 2>/dev/null | station_rows | head -n 1)
+            if [ "${g%%|*}" = "$mac" ]; then
+                set -f; local IFS='|'; set -- $g; IFS=' 	
+'; set +f
+                sig=${sig:-${2:-}}; tx=${tx:-${3:-}}; rx=${rx:-${4:-}}; ct=${ct:-${5:-}}
+            fi
+        fi
+        printf '%s|%s|%s|%s|%s\n' "$mac" "$sig" "$tx" "$rx" "$ct"
+    done
+}
+W_CLIENTS=$(printf '%s\n' "$W_CLIENTS" | station_fill)
+W_CN=0; W_CLIST=
+while IFS='|' read -r mac sig txr rxr ct; do
+    [ -n "$mac" ] || continue
+    line=$(awk -v m="$mac" 'tolower($2) == m { print $3 "|" $4; exit }' "$LEASES_FILE" 2>/dev/null)
+    ip=${line%%|*}; host=${line#*|}
+    { [ "$host" = "$line" ] || [ "$host" = '*' ]; } && host=
+    W_CLIST="$W_CLIST{\"mac\":$(qs "$mac"),\"host\":$(qs "$host"),\"ip\":$(qs "$ip"),\"signal\":$(n_or_null "$sig"),\"tx\":$(qs "$txr"),\"rx\":$(qs "$rxr"),\"conn\":$(qs "$ct")},"
+    W_CN=$((W_CN + 1))
+done <<EOF2
+$(printf '%s\n' "$W_CLIENTS")
+EOF2
+W_CLIST=${W_CLIST%,}
+LAN_LEASES=$(cat "$LEASES_FILE" 2>/dev/null | wc -l)
+# recent DHCP leases (host/ip/mac + remaining time) - shows devices that were
+# here even when nobody is associated right now
+NOWS=$NOW
+LEASES=
+while read -r exp mac ip host _cid; do
+    [ -n "$mac" ] || continue
+    [ "$host" = "*" ] && host=
+    case $exp in ''|*[!0-9]*) exp=$NOWS ;; esac   # never a file value in $(( ))
+    left=$(( exp - NOWS ))
+    [ "$left" -lt 0 ] && left=0
+    LEASES="$LEASES{\"host\":$(qs "$host"),\"ip\":$(qs "$ip"),\"mac\":$(qs "$mac"),\"left\":$left},"
+done < "$LEASES_FILE" 2>/dev/null
+LEASES=${LEASES%,}
+LAN_IP=$(t2 ip -4 addr show "$LAN_DEVICE" 2>/dev/null | awk '/inet /{split($2,a,"/"); print a[1]; exit}')
+
+# ---------------------------------------------------------------- modem/path
+# the same liveness rule mu300-atd uses: the URC log on nr0 is written to as
+# long as the modem is running, whatever it thinks of our commands
+URCLOG=/run/mu300-at/urc/stty_nr$((SIM_SLOT * 3)).log
+if [ -f "$URCLOG" ]; then
+    AGE=$(( NOW - $(date -r "$URCLOG" +%s 2>/dev/null || echo 0) ))
+    [ "$AGE" -lt 240 ] && MODEM_ALIVE=1 || MODEM_ALIVE=0
+else
+    MODEM_ALIVE=0
+fi
+ATD_OK=0; /usr/libexec/unisoc-modem/at --available >/dev/null 2>&1 && ATD_OK=1
+[ "$MODEM_ALIVE" = 1 ] || MODEM_ALIVE=$ATD_OK
+DATA_PAUSED=0; [ -e /run/mu300-mobile-data-down ] && DATA_PAUSED=1
+# Tracked connections: the kernel's counter needs no CONFIG_NF_CONNTRACK_PROCFS (the mainline kernel has no
+# /proc/net/nf_conntrack); the table is the fallback; neither readable is unknown (null), never a made-up 0. The
+# counter is read with cat in one go: a sysctl file may answer a second short read with EOF. Based on
+# kanoqwq/mu300-linux@373e191.
+conntrack_count() {
+    local count counter=${MU300_CONNTRACK_COUNT:-/proc/sys/net/netfilter/nf_conntrack_count}
+    local table=${MU300_CONNTRACK_TABLE:-/proc/net/nf_conntrack}
+    if [ -r "$counter" ] && count=$(cat "$counter" 2>/dev/null); then
+        case $count in ''|*[!0-9]*) ;; *) echo "$count"; return ;; esac
+    fi
+    if [ -r "$table" ] && count=$(wc -l < "$table" 2>/dev/null); then
+        echo $((count + 0)); return
+    fi
+    echo null
+}
+CONNS=$(conntrack_count)
+
+# --------------------------------------------------------------------- VPN
+VPN_ENABLED=0; VPN_ENGINE=""; VPN_UP=0
+# ENABLE is still vpn.conf's. The engine is the active profile's TYPE (/etc/mu300/vpn/active names the profile,
+# its meta holds TYPE='...'); a device that has not been migrated yet, or runs an older mu300-vpn, has only
+# vpn.conf's ENGINE. The id is checked before it becomes a path and meta is read with sed, never sourced.
+if [ -r /etc/mu300/vpn.conf ]; then
+    grep -q '^ENABLE=1' /etc/mu300/vpn.conf && VPN_ENABLED=1
+fi
+VPN_ACTIVE=$(head -c 64 /etc/mu300/vpn/active 2>/dev/null | head -n1)
+case $VPN_ACTIVE in
+    *[!a-z0-9-]*|'') ;;
+    *) [ ${#VPN_ACTIVE} -le 32 ] && VPN_ENGINE=$(sed -n "s/^TYPE=//p" "/etc/mu300/vpn/profiles/$VPN_ACTIVE/meta" 2>/dev/null \
+                                                     | tail -n1 | sed "s/^'//; s/'\$//") ;;
+esac
+[ -n "$VPN_ENGINE" ] || VPN_ENGINE=$(sed -n 's/^ENGINE=//p' /etc/mu300/vpn.conf 2>/dev/null | tail -n1)
+# up: the interface the last run brought up (/run/mu300-vpn/iface, any driver), or the two legacy engines' own
+# names; a name is only given to ip when it looks like one
+VPN_IF=$(head -c 32 /run/mu300-vpn/iface 2>/dev/null | head -n1)
+case $VPN_IF in *[!A-Za-z0-9_.-]*|'') VPN_IF="" ;; esac
+if { [ -n "$VPN_IF" ] && ip link show "$VPN_IF" >/dev/null 2>&1; } \
+    || ip link show xtun >/dev/null 2>&1 || ip link show sbtun >/dev/null 2>&1; then VPN_UP=1; fi
+# the VPN is a module of its own (github.com/dikeckaan/mu300-linux-vpn): present when its hook linked mu300-vpn and the
+# service into this system (the images have neither)
+CAP_VPN=0; [ -x /opt/mu300/bin/mu300-vpn ] && [ -x /etc/init.d/mu300-vpn ] && CAP_VPN=1
+# orphaned: the VPN on with its kill switch and no module to enforce it - mobile data and the Wi-Fi client then stay
+# down (lib/vpn-orphan.sh; MU300_SYSROOT, MU300_VPN_CMD, MU300_VPN_ORPHAN_LIB: tests)
+VPN_ORPHANED=0
+_vol=${MU300_VPN_ORPHAN_LIB:-/opt/mu300/lib/vpn-orphan.sh}
+if [ -r "$_vol" ] && . "$_vol" && vpn_killswitch_orphaned "${MU300_VPN_CMD:-/opt/mu300/bin/mu300-vpn}" "${MU300_SYSROOT:-}"; then
+    VPN_ORPHANED=1
+fi
+CAP_DUALBOOT=0; [ -x /opt/mu300/bin/mu300-next-boot ] && CAP_DUALBOOT=1
+# mu300-next-boot lock: the wish on the Linux disk (the panel shows it; the slot itself is in misc)
+BOOT_LOCK=0
+for _d in /mnt/mu300-disk ""; do [ -f "$_d/.mu300/boot-lock" ] && { BOOT_LOCK=1; break; }; done
+
+# A newer release: the note mu300-update keeps (notice, at boot and every 6 hours; this only reads it). Its tag, for
+# the home page's link to System > Update.
+UPDATE_TAG=$(sed -n 's/^mu300-linux \(v[0-9.]*\) is out .*/\1/p' "${MU300_NOTICE:-/run/mu300/update-available}" 2>/dev/null | head -n1)
+# (a release tag, docs/FINDINGS.md 125: vYYYY.MM.DD, and vYYYY.MM.DD.N after v2026.10.27)
+printf '%s\n' "$UPDATE_TAG" | LC_ALL=C grep -Eqx -- 'v[0-9]{4}\.[0-9]{2}\.[0-9]{2}|v[0-9]{4}\.(0[1-9]|1[0-2])\.(0[1-9]|[12][0-9]|3[01])\.[1-9][0-9]?' || UPDATE_TAG=
+
+# ------------------------------------------------------------- data usage
+# mu300-traffic's service writes this summary after each of its readings (RAM, once a minute): today and the
+# billing cycle, against the cap. Numbers and fixed words only; anything else is left out.
+TSUM=${MU300_TRAFFIC_SUMMARY:-/run/mu300/traffic/summary}
+tsum() { sed -n "s/^$1=//p" "$TSUM" 2>/dev/null | head -n1; }
+tint() { v=$(tsum "$1"); case $v in ''|*[!0-9]*|0?*) echo 0 ;; *) echo "$v" ;; esac; }
+T_LEVEL=$(tsum level); case $T_LEVEL in ok|warn|over|none) ;; *) T_LEVEL= ;; esac
+
+# ------------------------------------------------------------------ USB link
+# The USB-C port's link speed as negotiated with whatever sits at the other end of the cable. Device
+# mode: the gadget's UDC reports it ("high-speed", "super-speed", "super-speed-plus"). Host mode (mu300-usb host) has
+# no UDC, and the attached device's own speed file is the answer. A USB 2.0 only cable or host port caps a 10 Gbps
+# capable port at 480 Mbps, which is why the page shows this as a downgrade instead of hiding it.
+USB_UDC_DIR=${MU300_UDC_DIR:-/sys/class/udc}
+USB_DEV_DIR=${MU300_USB_DEVICES_DIR:-/sys/bus/usb/devices}
+usb_mbps() {  # a speed word from sysfs, or a number already in Mbps -> integer Mbps (empty when unknown)
+    case $1 in
+        low-speed) echo 1 ;;
+        full-speed) echo 12 ;;
+        high-speed) echo 480 ;;
+        super-speed) echo 5000 ;;
+        super-speed-plus) echo 10000 ;;
+        ''|*[!0-9]*) ;;
+        *) echo "$1" ;;
+    esac
+}
+usb_link() {  # -> {"role":"device","speed":"high-speed","mbps":480,"max":"super-speed-plus","max_mbps":10000} | null
+    local u s m best best_s
+    for u in "$USB_UDC_DIR"/*; do
+        [ -r "$u/current_speed" ] || continue
+        s=$(rd "$u/current_speed"); m=$(rd "$u/maximum_speed")
+        printf '{"role":"device","speed":%s,"mbps":%s,"max":%s,"max_mbps":%s}' \
+            "$(qs "$s")" "$(n_or_null "$(usb_mbps "$s")")" "$(qs "$m")" "$(n_or_null "$(usb_mbps "$m")")"
+        return
+    done
+    # host mode: the fastest attached device; a root hub (1d6b) reports the port's own speed, not a device's
+    for u in "$USB_DEV_DIR"/*/speed; do
+        [ -r "$u" ] || continue
+        [ "$(rd "${u%/speed}/idVendor")" = 1d6b ] && continue
+        s=$(rd "$u"); m=$(usb_mbps "$s"); [ -n "$m" ] || continue
+        if [ -z "$best" ] || [ "$m" -gt "$best" ] 2>/dev/null; then best=$m; best_s=$s; fi
+    done
+    [ -n "$best" ] || { echo null; return; }
+    printf '{"role":"host","speed":%s,"mbps":%s,"max":null,"max_mbps":null}' "$(qs "$best_s")" "$best"
+}
+
+# ------------------------------------------------------------------ output
+printf '{"ts":%d,"uptime":%d,"host":%s,"model":%s,"fw":%s,"kernel":%s,' \
+    "$NOW" "$UPTIME" "$(qs "$HOST")" "$(qs "$MODEL")" "$(qs "$FW")" "$(qs "$(uname -r)")"
+printf '"cpu":{"n":%d,"total":%d,"idle":%d,"freqs":[%s]},' "$CPUN" "$CPU_TOTAL" "$CPU_IDLE" "${FREQS:-}"
+printf '"mem":{"total_kb":%s,"avail_kb":%s},' "$(n_or_null "$MEM_T")" "$(n_or_null "$MEM_A")"
+printf '"storage":{"total_kb":%s,"used_kb":%s,"avail_kb":%s},' "$(n_or_null "$DISK_T")" "$(n_or_null "$DISK_U")" "$(n_or_null "$DISK_A")"
+printf '"temps":{"soc":%s,"cpu":%s,"modem":%s,"board":%s,"hottest":%s},' \
+    "$(f_or_null "$T_SOC")" "$(f_or_null "$T_CPU")" "$(f_or_null "$T_NR")" "$(f_or_null "$T_BRD")" "$(f_or_null "$T_HOT")"
+printf '"power":{"present":%d,"capacity":%s,"status":%s,"volt":%s,"ua":%s,"w":%s,"usb":%s,"in_volt":%s,"in_ua":%s,"in_w":%s},' \
+    "$P_PRESENT" "$(n_or_null "$P_CAP")" "$(qs "$P_STATUS")" "$(n_or_null "$P_V")" "$(n_or_null "$P_I")" \
+    "$(n_or_null "$P_W")" "$(n_or_null "$P_USB")" "$(n_or_null "$P_IN_V")" "$(n_or_null "$P_IN_I")" "$(n_or_null "$P_IN_W")"
+printf '"net":{"mobile":%s,"sipa_eth0":%s,"brlan":%s,"wlan0":%s,"usb0":%s},' \
+    "$(net_obj "$DATA_DEVICE")" "$(net_obj "$DATA_DEVICE")" "$(net_obj "$LAN_DEVICE")" "$(net_obj "$WIFI_DEVICE")" "$(net_obj "$USB_DEVICE")"
+printf '"usblink":%s,' "$(usb_link)"
+# the interface the page reads its live rates of (from /proc/net/dev, every second)
+printf '"data_device":%s,' "$(qs "$DATA_DEVICE")"
+printf '"sim":%s,' "$SIM_JSON"
+if [ -n "$T_LEVEL" ]; then
+    printf '"traffic":{"level":"%s","today":%s,"used":%s,"cap":%s,"warn":%s,"clock":%s},' "$T_LEVEL" \
+        "$(( $(tint today_rx) + $(tint today_tx) ))" "$(tint used)" "$(tint cap)" "$(tint warn)" "$(tint clock)"
+else
+    printf '"traffic":null,'
+fi
+printf '"wan":{"up":%d,"uptime":%s,"proto":%s,"apn":%s,"ip4":%s,"ip6":%s,"dns":%s,"roaming":{"allowed":%d,"held":%d}},' \
+    "$wan_up" "$(n_or_null "$wan_uptime")" "$(qs "$wan_proto")" "$(qs "$apn")" "$(qs "$wan_ip4")" "$(qs "$wan6_ip")" "$(qs "$wan_dns")" \
+    "$roam_allowed" "$roam_held"
+printf '"wifi":{"up":%d,"ssid":%s,"channel":%s,"band":%s,"width":%s,"country":%s,"enc":%s,"hidden":%s,"hostapd":%d,"clients":[%s],"clients_n":%d},' \
+    "$W_UP" "$(qs "$W_SSID")" "$(qs "$W_CH")" "$(qs "$W_BAND")" "$(qs "$W_WIDTH")" "$(qs "$W_COUNTRY")" "$(qs "$W_ENC")" "$(n_or_null "$W_HIDDEN")" "$W_HOSTAPD" "${W_CLIST:-}" "$W_CN"
+printf '"lan":{"leases":%s,"ip":%s,"list":[%s]},' "$(n_or_null "$LAN_LEASES")" "$(qs "$LAN_IP")" "${LEASES:-}"
+printf '"modem":{"alive":%d,"atd":%d,"data_paused":%d},' "$MODEM_ALIVE" "$ATD_OK" "$DATA_PAUSED"
+printf '"capabilities":{"vpn":%d,"dualboot":%d,"bootlock":%d},' "$CAP_VPN" "$CAP_DUALBOOT" "$BOOT_LOCK"
+printf '"update":%s,' "$(qs "$UPDATE_TAG")"
+printf '"conns":%s,' "$(n_or_null "$CONNS")"
+printf '"vpn":{"enabled":%d,"engine":%s,"up":%d,"orphaned":%d}}\n' "$VPN_ENABLED" "$(qs "$VPN_ENGINE")" "$VPN_UP" "$VPN_ORPHANED"
