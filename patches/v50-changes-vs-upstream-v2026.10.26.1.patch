@@ -1,6 +1,7 @@
 #!/bin/sh /etc/rc.common
 # the buttons: power wakes the LEDs (held: shut down), the U30 Air's Wi-Fi key switches the hotspot band
-# (see /opt/mu300/bin/mu300-buttons)
+# (see /opt/mu300/bin/mu300-buttons). The V50 has one key instead (KEY_FN 464): a press switches the band,
+# a 10 s hold reboots.
