+	procd_set_param command /bin/sh -c "for i in $(seq 1 10); do grep -q ':0016 .* 0A ' /proc/net/tcp && { exec /opt/mu300/bin/mu300-next-boot --rearm; }; sleep 30; done; logger -t mu300-post 'no SSH after 5 min: not re-arming (the next boot returns to Android)'"
+	procd_set_param env PATH="$PATH"
+	procd_close_instance
+	# Once per boot: record (and if needed repair) what decides whether a Wi-Fi client gets an address.
+	# See opt/mu300/bin/mu300-lancheck - without it a boot that serves nobody looks identical to a good one.
+	procd_open_instance lancheck
+	procd_set_param command /opt/mu300/bin/mu300-lancheck
 	procd_set_param env PATH="$PATH"
 	procd_close_instance
 }
