new file mode 100644
index 0000000..797e852
--- /dev/null
+++ b/openwrt/vendor-extra/etc/apk/repositories.d/distfeeds.list
@@ -0,0 +1,47 @@
+# apk package feeds - pinned to the Tsinghua (TUNA) mirror of downloads.openwrt.org.
+#
+# This file REPLACES the one baked into the rootfs tarball: openwrt/build-rootfs.sh does
+# `cp -a /in/overlay/. $R/` after unpacking the image, so this copy is the one that survives.
+# A device installed from a PREBUILT release never reads openwrt/overlay/, which is why step 7
+# of apply-v50-patches.ps1 mirrors this file into openwrt/vendor-extra/ as well.
+#
+# Measured on the V50 over 4G (2026-10-10), the same 8 indexes, same device, same minute:
+#   downloads.openwrt.org            8/8 reachable, 1.54 MB in 18 s, apk update 7 s
+#   mirrors.tuna.tsinghua.edu.cn     8/8 reachable, 1.54 MB in  8 s, apk update 4 s
+#   mirrors.aliyun.com/openwrt       0/8 reachable (all 404),         apk update FAILS (rc=8)
+# The TUNA copy is byte-identical to the official index (sha256 of
+# packages/aarch64_generic/base/packages.adb matches downloads.openwrt.org exactly), and
+# `apk update` reports the same 11178 packages from either.
+#
+# WHY NOT ALIYUN, since mirrors.aliyun.com/openwrt is the obvious first guess:
+# that mirror's releases/ tree stops at 25.12.0-rc2 and does not carry 25.12.5, the release
+# this image is built from (openwrt/build-rootfs.sh: MU300_WRT_VER defaults to 25.12.5).
+# Every one of the 8 index URLs 404s there, so `apk update` exits 8 and only 226 packages
+# remain visible instead of 11178 - the device looks like it has a working package manager
+# right up until something is actually installed. Verified on the device, not inferred.
+#
+# Other mirrors measured to carry the same 8 indexes with identical bytes (all 8/8, all
+# 20/20 on repeated requests), should TUNA ever be unreachable:
+#   https://mirrors.ustc.edu.cn/openwrt/
+#   https://mirror.sjtu.edu.cn/openwrt/
+#   https://mirror.nju.edu.cn/openwrt/
+#   https://mirrors.bfsu.edu.cn/openwrt/
+#   https://mirrors.cloud.tencent.com/openwrt/
+# Do NOT use https://repo.huaweicloud.com/openwrt/ : it answers 200 with an HTML page for
+# paths that do not exist, so a HEAD probe reports "available" for a feed that is not there.
+#
+# To go back to upstream, replace the host below with https://downloads.openwrt.org - the
+# paths do not change. The kernel version in the kmods path (6.12.94-1-ba5ca7f...) is part
+# of the path and must match the running kernel: an index for another kernel is not a
+# fallback, it is a wrong answer.
+#
+# Contents are comments and 8 URLs; this file is read by apk, not by a shell.
+
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.5/targets/armsr/armv8/packages/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.5/packages/aarch64_generic/base/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.5/targets/armsr/armv8/kmods/6.12.94-1-ba5ca7f3e73618aeece9cc1c14e512c2/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.5/packages/aarch64_generic/luci/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.5/packages/aarch64_generic/packages/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.5/packages/aarch64_generic/routing/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.5/packages/aarch64_generic/telephony/packages.adb
+https://mirrors.tuna.tsinghua.edu.cn/openwrt/releases/25.12.5/packages/aarch64_generic/video/packages.adb
diff --git a/openwrt/vendor-extra/etc/hotplug.d/iface/10-mu300-usb b/openwrt/vendor-extra/etc/hotplug.d/iface/10-mu300-usb
new file mode 100644
index 0000000..2aeee75
--- /dev/null
+++ b/openwrt/vendor-extra/etc/hotplug.d/iface/10-mu300-usb
@@ -0,0 +1,64 @@
+#!/bin/sh
+# MU300: the LAN is up - the hand-over from the early DHCP server, then the macOS re-enumeration.
+[ "$ACTION" = ifup ] && [ "$INTERFACE" = lan ] || exit 0
+
+# K9 (ported from the kanoqwq fork, cd4fb28 and 4e70d02): dnsmasq serves the LAN now, so the early server of
+# preinit (06_mu300_early_usb) goes. Then the address boot/init and preinit put on the gadget's netdev: netifd can leave it
+# there after enslaving the netdev to br-lan, which makes two equal routes for the LAN subnet; replies then leave
+# through the wrong device and the host cannot even ping br-lan. It is taken off a bridge port only when it is the
+# bridge's own, after netifd has put that on br-lan. And rndis0: an installed system's bridge section may predate a
+# switch to RNDIS, so it is put back into br-lan on every LAN ifup (a network reload too).
+pid=$(cat /run/mu300-early-udhcpd.pid 2>/dev/null)
+[ -n "$pid" ] && kill "$pid" 2>/dev/null
+rm -f /run/mu300-early-udhcpd.pid
+bridge_ip=$(ip -4 -o addr show dev br-lan 2>/dev/null | awk 'NR == 1 { print $4 }')
+if [ -n "$bridge_ip" ]; then
+	for nic in usb0 rndis0; do
+		ip -o link show dev "$nic" 2>/dev/null | grep -q 'master br-lan' || continue
+		# the bridge's address with whatever prefix the port has (preinit's mask can differ from netifd's)
+		nic_ip=$(ip -4 -o addr show dev "$nic" 2>/dev/null |
+			awk -v a="${bridge_ip%/*}" '{ split($4, p, "/"); if (p[1] == a) { print $4; exit } }')
+		[ -n "$nic_ip" ] || continue
+		ip addr del "$nic_ip" dev "$nic" 2>/dev/null || true
+	done
+fi
+if [ -e /sys/class/net/rndis0 ]; then
+	ip link set rndis0 master br-lan 2>/dev/null
+	ip link set rndis0 up 2>/dev/null
+fi
+# ... and the same address check once more, now that rndis0 is a port.
+#
+# The loop above only looks at netdevs that are already ports of br-lan, and rndis0 was put into
+# br-lan on the line before this one - so on a system whose gadget is RNDIS it was never checked.
+# Left holding the early server's address, the LAN subnet gets two equal routes and replies leave
+# through rndis0: a Wi-Fi client that has associated cannot even ping br-lan. (V50, 2026-10-10)
+if [ -n "$bridge_ip" ]; then
+	for nic in usb0 rndis0; do
+		ip -o link show dev "$nic" 2>/dev/null | grep -q 'master br-lan' || continue
+		nic_ip=$(ip -4 -o addr show dev "$nic" 2>/dev/null |
+			awk -v a="${bridge_ip%/*}" '{ split($4, p, "/"); if (p[1] == a) { print $4; exit } }')
+		[ -n "$nic_ip" ] || continue
+		ip addr del "$nic_ip" dev "$nic" 2>/dev/null || true
+	done
+fi
+
+# The ECM gadget was bound in the initramfs; macOS keeps the link inactive after netifd reconfigures usb0
+# (at boot and on every network restart). Re-enumerate the gadget whenever the LAN comes up, at most every 20 s,
+# so the host starts DHCP on a fresh link. (Kept, K10: the fork replaces it with one rebind in mu300-post, K12,
+# which waits for its gate on macOS.)
+stamp=/tmp/mu300-usb-rebound
+now=$(cut -d. -f1 /proc/uptime)
+[ -e $stamp ] && [ $((now - $(cat $stamp))) -lt 20 ] && exit 0
+echo "$now" > $stamp
+C=/sys/kernel/config
+grep -q " $C configfs" /proc/mounts || mount -t configfs configfs $C 2>/dev/null
+g=$C/usb_gadget/linux
+[ -e $g/UDC ] || exit 0
+udc=$(cat $g/UDC)
+[ -n "$udc" ] || udc=$(ls /sys/class/udc | head -1)
+(
+	sleep 2
+	echo "" > $g/UDC 2>/dev/null
+	sleep 1
+	echo "$udc" > $g/UDC && logger -t mu300 "usb gadget re-enumerated on $udc"
+) &
diff --git a/openwrt/vendor-extra/etc/init.d/mu300-hw b/openwrt/vendor-extra/etc/init.d/mu300-hw
new file mode 100644
index 0000000..1ad8e62
--- /dev/null
+++ b/openwrt/vendor-extra/etc/init.d/mu300-hw
@@ -0,0 +1,71 @@
+#!/bin/sh /etc/rc.common
+# Hardware bring-up before netifd: vendor drivers, zram, Wi-Fi (SC2355), first-boot Wi-Fi config, Bluetooth off
+START=12
+export PATH="$PATH:/opt/mu300/busybox-bin"
+
+# Everything here runs in the background on purpose. busybox init only spawns the consoles after sysinit has
+# finished, so anything slow (or hanging) in here costs the device its serial console *and* its network - which
+# is exactly what a hanging wifi-start did on the mainline kernel, leaving no way in at all.
+# Run a bring-up step under a deadline, killing the whole process tree if it overruns.
+#
+# Why this exists (V50, 2026-10-09): this script runs before netifd, and a hanging step here costs the
+# device its network and its login - busybox init only spawns the consoles after sysinit returns. The
+# SC2355/Marlin3 stack (wcn_bsp, sprd_wlan_combo) is the known offender: insmod of sprd_wlan_combo can
+# block for good on a board whose WLAN firmware differs from the tested one, and `wifi up` waits on the
+# same driver. When that happened the hotspot still associated and dnsmasq even answered DHCP, but
+# dropbear and uhttpd never came up, so the device was unreachable with nothing on screen saying why.
+# Every step is therefore bounded: whatever fails, the rest of the boot continues and the SSH console
+# stays available to look at it.
+bringup_step() {  # bringup_step DEADLINE_SECONDS NAME COMMAND...
+	_bg_deadline=$1; _bg_name=$2; shift 2
+	_bg_pid=
+	( "$@" ) >>/tmp/mu300-$_bg_name.log 2>&1 &
+	_bg_pid=$!
+	_bg_n=0
+	while kill -0 "$_bg_pid" 2>/dev/null; do
+		if [ "$_bg_n" -ge "$_bg_deadline" ]; then
+			echo "$_bg_name: exceeded ${_bg_deadline}s, killed (continuing the boot)" >>/tmp/mu300-$_bg_name.log 2>&1
+			# the step may have children (modprobe -> insmod, wifi -> hostapd): kill the group
+			kill -TERM -"$_bg_pid" 2>/dev/null || kill -TERM "$_bg_pid" 2>/dev/null
+			sleep 2
+			kill -KILL -"$_bg_pid" 2>/dev/null || kill -KILL "$_bg_pid" 2>/dev/null
+			break
+		fi
+		sleep 1
+		_bg_n=$((_bg_n + 1))
+	done
+	wait "$_bg_pid" 2>/dev/null
+	return 0
+}
+
+boot() {
+	/opt/mu300/bin/mu300-led power on
+	/opt/mu300/bin/mu300-usb boot
+	hw_bringup > /tmp/mu300-hw.log 2>&1 &
+}
+
+hw_bringup() {
+	bringup_step 60 extra-modules /opt/mu300/bin/extra-modules
+	bringup_step 30 zram-start /opt/mu300/bin/zram-start
+	# the Marlin3 stack: insmod of sprd_wlan_combo can block for good, so this is the bounded one that matters
+	bringup_step 90 wifi-start /opt/mu300/bin/wifi-start
+	# cfg80211 looked for regulatory.db before the rootfs was mounted; load it now so hostapd sees the country rules
+	bringup_step 20 regdb-load /opt/mu300/bin/regdb-load
+	bringup_step 45 openwrt-wifi-config /opt/mu300/bin/openwrt-wifi-config
+	# the U30 Air's NFC tag: the hotspot's name and password, if that is what it holds (see mu300-nfc)
+	[ "$(/opt/mu300/bin/mu300-device)" = u30air ] && bringup_step 20 mu300-nfc /opt/mu300/bin/mu300-nfc sync
+	# apply the country before netifd starts hostapd, otherwise 5 GHz channels are still NO-IR under world rules
+	country=$(uci -q get wireless.radio0.country)
+	if [ -n "$country" ]; then
+		iw reg set "$country"
+		for n in $(seq 1 10); do iw reg get | grep -q "country $country:" && break; sleep 1; done
+	fi
+	# a reload does not restart a hostapd interface that went AP-DISABLED while the world regulatory domain
+	# was still active; one down/up right after the country is live does
+	bringup_step 60 wifi-down wifi down
+	bringup_step 60 wifi-up wifi up
+}
+
+start() {
+	boot
+}
diff --git a/openwrt/vendor-extra/etc/init.d/mu300-post b/openwrt/vendor-extra/etc/init.d/mu300-post
new file mode 100644
index 0000000..9f60a82
--- /dev/null
+++ b/openwrt/vendor-extra/etc/init.d/mu300-post
@@ -0,0 +1,68 @@
+#!/bin/sh /etc/rc.common
+# After boot: keep mobile data up across modem resets, and mark the boot successful (re-arm the Linux slot if Linux
+# is the default)
+START=99
+USE_PROCD=1
+export PATH="$PATH:/opt/mu300/busybox-bin"
+
+# LuCI (or "uci commit wireless; reload_config") turning the hotspot off or on: no hostapd hook tells mu300-led,
+# so the Wi-Fi LED follows what wlan0 is for two minutes: Wi-Fi turned off and on again at once took hostapd 63 s
+# to come back on F50 #1 (6.18). (A reload only runs this.)
+service_triggers() {
+	procd_add_reload_trigger wireless
+}
+
+reload_service() {
+	( sleep 5; /opt/mu300/bin/mu300-led wifi sync 120 ) >/dev/null 2>&1 &
+}
+
+start_service() {
+	# the commands on the PATH (/usr/bin): new ones on a system installed before they existed, and the extras'
+	/opt/mu300/bin/mu300-extra link >/dev/null 2>&1
+
+	# the host gives up asking for a DHCP lease long before this device finishes booting; if nothing took an
+	# address, make the gadget re-enumerate once, which looks like a fresh cable to the host
+	procd_open_instance usb-lease
+	procd_set_param command /opt/mu300/bin/mu300-usb-reset --if-no-lease 25
+	procd_close_instance
+	# K13 (ported from the kanoqwq fork, cd4fb28): the U30 Air has a second gadget netdev on some kernels; it
+	# belongs to the LAN like usb0
+	[ -e /sys/class/net/usb1 ] && ip link set usb1 master br-lan 2>/dev/null && ip link set usb1 up
+
+	procd_open_instance cellwatch
+	procd_set_param command /opt/mu300/bin/mobile-data watch
+	procd_set_param env MU300_NETIFD=1 PATH="$PATH"
+	procd_set_param respawn 3600 30 0
+	procd_close_instance
+	procd_open_instance thermalguard
+	procd_set_param command /opt/mu300/bin/thermal-guard
+	procd_set_param env PATH="$PATH"
+	procd_close_instance
+	# the SC2355 sometimes refuses the first IFF_UP (EIO); if the AP did not come up, try once more
+	procd_open_instance wifiretry
+	procd_set_param command /bin/sh -c "sleep 45; [ -e /sys/class/net/wlan0 ] || exit 0; ubus call hostapd.wlan0 get_status >/dev/null 2>&1 || { logger -t mu300-post 'AP not up, retrying'; wifi up; sleep 15; }; /opt/mu300/bin/mu300-led wifi sync"
+	procd_close_instance
+	# a newer release: a note at login (/etc/profile.d/mu300-update.sh) and in mu300-toolkit, nothing installed
+	procd_open_instance updatenotice
+	procd_set_param command /bin/sh -c "sleep 300; while :; do /opt/mu300/bin/mu300-update notice >/dev/null 2>&1 && s=21600 || s=3600; sleep \$s; done"
+	procd_set_param env PATH="$PATH"
+	procd_close_instance
+# Re-arm the Linux slot only once the device is actually reachable.
+	#
+	# Upstream does this unconditionally 30 s after the service starts, which marks a boot "good" even when
+	# OpenWrt came up but dropbear and uhttpd never did (V50, 2026-10-09). mu300-next-boot --rearm also
+	# clears the initramfs counter .mu300/boot-tries, so an unconditional re-arm resets BOTH fallback
+	# counters on every boot and the device can never return to Android on its own - power cycling stops
+	# helping entirely. Ubuntu's mu300-boot-ok waits for the USB network and SSH first; do the same here.
+	# ':0016 .* 0A' is a listening socket on port 22 in /proc/net/tcp.
+	procd_open_instance bootok
+	procd_set_param command /bin/sh -c "for i in $(seq 1 10); do grep -q ':0016 .* 0A ' /proc/net/tcp && { exec /opt/mu300/bin/mu300-next-boot --rearm; }; sleep 30; done; logger -t mu300-post 'no SSH after 5 min: not re-arming (the next boot returns to Android)'"
+	procd_set_param env PATH="$PATH"
+	procd_close_instance
+	# Once per boot: record (and if needed repair) what decides whether a Wi-Fi client gets an address.
+	# See opt/mu300/bin/mu300-lancheck - without it a boot that serves nobody looks identical to a good one.
+	procd_open_instance lancheck
+	procd_set_param command /opt/mu300/bin/mu300-lancheck
+	procd_set_param env PATH="$PATH"
+	procd_close_instance
+}
diff --git a/openwrt/vendor-extra/etc/uci-defaults/90-mu300 b/openwrt/vendor-extra/etc/uci-defaults/90-mu300
new file mode 100644
index 0000000..701df80
--- /dev/null
+++ b/openwrt/vendor-extra/etc/uci-defaults/90-mu300
@@ -0,0 +1,178 @@
+#!/bin/sh
+# The MU300's OpenWrt settings: what the system needs on every run, and first-install defaults once.
+#
+# This runs more than once: mu300-update apply and android-install.sh UPDATE=1 unpack a fresh rootfs (which carries
+# /etc/uci-defaults again) and keep /etc/config, so it runs on the first boot after every update, against the
+# user's settings.
+#
+# Once (a first install): one LAN for USB and Wi-Fi (192.168.77.1/24 on an F50, 192.168.78.1/24 on a U30 Air) with
+# the USB gadget in its bridge, no wan6, an empty APN, the hostname and time zone, and fw4's software flowtable. The
+# marker system.mu300.defaults is written last, in /etc/config with the settings it guards: an update keeps both, a
+# fresh or reset configuration has neither and gets the defaults again.
+# An install from before the marker is told by its wan: only this script makes wan the modem's (proto mu300cell),
+# and no first boot has that, so such a configuration was set up by an earlier run and keeps its settings. It gets
+# the one default the releases before the marker did not set (the flowtable), and the marker.
+#
+# Every run: wan is the modem's, the LAN bridge does not wait for a missing member, the USB host's pinned lease when
+# there is none (K25), the early USB path's firewall zone (K26), and the USB serial console in the fresh inittab.
+lan_ip=$(/opt/mu300/bin/mu300-lan-ip)
+# The USB host's MAC (K25): boot/init leaves it in /run (the gadget's host_addr); else the gadget's own address
+# tells it (init gives the host the next one: :01 -> :02 for usb0, :03 -> :04 for rndis0).
+usb_host_mac=$(cat /run/mu300-usb-host-mac 2>/dev/null)
+for nic in usb0:02 rndis0:04; do
+	[ -z "$usb_host_mac" ] || break
+	devmac=$(cat /sys/class/net/${nic%:*}/address 2>/dev/null)
+	[ -n "$devmac" ] && usb_host_mac=${devmac%:*}:${nic#*:}
+done
+dev=$(uci -q show network | sed -n "s/^network\.\(@device\[[0-9]*\]\)\.name='br-lan'$/\1/p" | head -1)
+
+# first (a first install), old (an install from before the marker) or done; told before wan is set below
+if [ "$(uci -q get system.mu300.defaults)" = 1 ]; then run=done
+elif [ "$(uci -q get network.wan.proto)" = mu300cell ]; then run=old
+else run=first
+fi
+
+if [ "$run" = first ]; then
+	# lan ip6assign 64: a carrier hands out one /64 (the wan_6 that mu300cell adds), and the default /60 request
+	# would leave the LAN without IPv6 (openwrt-luci's 91-mu300-luci, run after this, asks for a /60 of the ULA)
+	uci -q batch <<UCI
+set system.@system[0].hostname='ZTE-V50'
+set system.@system[0].zonename='Asia/Shanghai'
+set system.@system[0].timezone='CST-8'
+# The regulatory domain decides which channels may radiate at all (see the note above step 16):
+# with none set, cfg80211 stays on the world domain, every 5 GHz channel is NO-IR, and hostapd refuses
+# to start the AP - the device boots with no hotspot and says nothing. US allows the most power of the
+# countries measured here on 2.4 GHz (30 dBm; BO and CN allow 20) and permits an AP on the low 5 GHz
+# channels too.  Change it with:  uci set wireless.radio0.country='DE'; uci commit wireless; wifi reload
+set wireless.radio0.country='US'
+set network.lan.ipaddr='$lan_ip'
+set network.lan.netmask='255.255.255.0'
+set network.lan.ip6assign='64'
+delete network.wan6
+set network.wan=interface
+set network.wan.apn=''
+UCI
+	# the armsr default bridges eth0; the MU300 LAN bridge carries the USB gadget (Wi-Fi joins via wireless config)
+	if [ -n "$dev" ]; then
+		uci -q delete network.$dev.ports
+		uci add_list network.$dev.ports='usb0'
+		# the gadget's RNDIS netdev (Windows without NCM) exists only when init made RNDIS; the LAN hook
+		# (hotplug.d/iface/10-mu300-usb) bridges it when a later boot does (K27, kanoqwq fork cd4fb28 and 4e70d02)
+		[ -e /sys/class/net/rndis0 ] && uci add_list network.$dev.ports='rndis0'
+	fi
+fi
+if [ "$run" != done ]; then
+	# Forwarded TCP/UDP through the kernel's software flowtable (fw4 puts sipa_eth0 in it: patches/fw4-sipa-offload.patch).
+	# The Unisoc SIPA and SC2355 drivers have no nftables hardware flow offload. (mu300-ttl turns it off while a TTL
+	# is set.)
+	# Flow offload stays OFF (V50, 2026-10-10).
+	# It was on, and it broke forwarding: the WAN's device appears only after the modem
+	# dials, so fw4 renders accept_to_wan empty at boot, and the hotplug that would fix it
+	# (hotplug.d/iface/20-firewall, which runs 'fw4 -q reload') cannot: replacing the
+	# flowtable while flows are in it fails with Resource busy, and -q hides the error.
+	# Every forwarded TCP was then RST by handle_reject, while the router's own DNS kept
+	# working - so it reads as 'the hotspot has no DNS'. See docs/04-WiFi与DHCP根因分析.md.
+	# SIPA and SC2355 have no hardware offload anyway, so little is lost.
+	uci -q set firewall.@defaults[0].flow_offloading='0'
+	uci -q set firewall.@defaults[0].flow_offloading_hw='0'
+fi
+
+# --- every run
+uci -q batch <<UCI
+set network.wan=interface
+set network.wan.proto='mu300cell'
+UCI
+# the wired LAN does not wait for a member that is not there yet (Wi-Fi, a gadget netdev)
+[ -z "$dev" ] || uci set network.$dev.bridge_empty='1'
+# board.json names the LAN device "eth0" - a leftover from the armsr target, on a board that has no
+# eth0. LuCI's status page reads it as the builtin ethernet ports, so it listed a port that can never
+# come up and reported it as disconnected for ever. config_generate writes this file only when the
+# image is built, so the stale value survives every install and every update; nothing else fixes it.
+# The UCI side is already right, so copy that across. (V50, 2026-10-10)
+mu300_board_dev=$(uci -q get network.lan.device)
+if [ -n "$mu300_board_dev" ] && [ -f /etc/board.json ]; then
+	sed -i "s/\"device\": \"eth0\"/\"device\": \"$mu300_board_dev\"/" /etc/board.json 2>/dev/null || true
+fi
+# K25 (ported from the kanoqwq fork, cd4fb28): the USB host keeps the address it had from the early server, and
+# dnsmasq broadcasts its OFFER/ACK: Windows can keep asking for the early lease after it has already removed that
+# address, and a unicast reply to the removed address is lost in the NCM host stack. The address is the one preinit's
+# early server gives on the LAN as configured (lib/mu300/usb-host.sh: never the router's own). Added when there is
+# none (an install from before K25, or a host MAC not known yet); one that is there is left as it is.
+. /lib/mu300/usb-host.sh
+if [ -n "$usb_host_mac" ] && [ -z "$(uci -q get dhcp.mu300_usb)" ]; then
+	mu300_lan "$(uci -q get network.lan.ipaddr)" "$(uci -q get network.lan.netmask)"
+	usb_host_ip=$(mu300_usb_host_ip "${mu300_lan_addr:-$lan_ip}" "$mu300_lan_mask")
+	uci -q batch <<UCI
+set dhcp.mu300_usb=host
+set dhcp.mu300_usb.name='mu300-usb-host'
+set dhcp.mu300_usb.mac='$usb_host_mac'
+set dhcp.mu300_usb.ip='$usb_host_ip'
+set dhcp.mu300_usb.broadcast='1'
+UCI
+fi
+# K26 (same fork commit): before netifd makes br-lan, the early address lives on the gadget's netdev itself (preinit
+# 06_mu300_early_usb); the host's DHCP and management traffic there gets the LAN's input policy, never forwarding.
+# Bridged, the packets come in through br-lan as usual. Added once.
+if ! uci -q show firewall | grep -q "^firewall\.@zone\[[0-9]*\]\.name='earlyusb'$"; then
+	early=$(uci add firewall zone)
+	uci set firewall.$early.name='earlyusb'
+	uci add_list firewall.$early.device='usb0'
+	uci add_list firewall.$early.device='rndis0'
+	uci set firewall.$early.input='ACCEPT'
+	uci set firewall.$early.output='ACCEPT'
+	uci set firewall.$early.forward='REJECT'
+fi
+# K28 (V50, 2026-10-10): the lan zone has to own the bridge itself, not only its ports.
+#
+# fw4 derives a zone's interfaces from the ports of the network's bridge device. br-lan is declared
+# bridge_empty, and wlan0 only joins it when netifd brings the AP up - after fw4 has rendered the
+# ruleset. The lan zone then owns nothing: no jump for br-lan in the input chain, policy drop, and
+# every packet a client sends is discarded. Nothing reports it - /etc/config/firewall says
+# input='ACCEPT' either way, the AP is up and dnsmasq is listening - so a client that associates simply
+# never gets a lease. Naming the bridge costs nothing and a later port cannot undo it.
+lan_dev=$(uci -q get network.lan.device)
+if [ -n "$lan_dev" ]; then
+	for z in $(uci -q show firewall | sed -n "s/^firewall\.\([^.=]*\)\.name='lan'$/\1/p"); do
+		uci -q get "firewall.$z.device" | grep -qx "$lan_dev" || uci add_list "firewall.$z.device=$lan_dev"
+	done
+fi
+# LuCI's language (both systems) is English, not "auto" (which follows the browser): once, with its own marker
+# luci.mu300.lang, so a language the user picks later stays through every update. A system from before the marker
+# that still says "auto" (or nothing) gets English too: auto was nobody's choice there (luci-base's default, and
+# 91-mu300-luci's until it set English), and with the Turkish and Chinese catalogs now in the image it would switch
+# the language under the user. A language set on purpose stays.
+# The languages the image has catalogs for (Turkish and Chinese) are offered on every run: their own uci-defaults ran
+# when the image was built, and an update keeps the old /etc/config/luci, which may not know them (plain OpenWrt
+# before v2026.10.11 had none). One the user's configuration has stays as it is.
+if uci -q get luci.main >/dev/null; then
+	uci -q get luci.languages >/dev/null || uci -q set luci.languages=internal
+	[ ! -e /usr/lib/lua/luci/i18n/base.tr.lmo ] || uci -q get luci.languages.tr >/dev/null ||
+		uci -q set luci.languages.tr='Türkçe (Turkish)'
+	[ ! -e /usr/lib/lua/luci/i18n/base.zh-cn.lmo ] || uci -q get luci.languages.zh_cn >/dev/null ||
+		uci -q set luci.languages.zh_cn="$(printf '\347\256\200\344\275\223\344\270\255\346\226\207 (Simplified Chinese)')"
+	uci commit luci
+fi
+if uci -q get luci.main >/dev/null && [ "$(uci -q get luci.mu300.lang)" != 1 ]; then
+	case $(uci -q get luci.main.lang) in ''|auto) uci -q set luci.main.lang='en' ;; esac
+	uci -q batch <<UCI
+set luci.mu300=mu300
+set luci.mu300.lang='1'
+UCI
+	uci commit luci
+fi
+# network last: a first run cut short before its commit has no wan proto mu300cell yet, and runs again as a first
+# install, in full
+uci commit system
+uci commit dhcp
+uci commit firewall
+uci commit network
+grep -q '^ttyGS0:' /etc/inittab || echo 'ttyGS0::askfirst:/usr/libexec/login.sh' >> /etc/inittab
+# the marker last
+if [ "$run" != done ]; then
+	uci -q batch <<UCI
+set system.mu300=mu300
+set system.mu300.defaults='1'
+UCI
+	uci commit system
+fi
+exit 0
diff --git a/openwrt/vendor-extra/opt/mu300/bin/mu300-buttons b/openwrt/vendor-extra/opt/mu300/bin/mu300-buttons
new file mode 100644
index 0000000..236226b
--- /dev/null
+++ b/openwrt/vendor-extra/opt/mu300/bin/mu300-buttons
@@ -0,0 +1,130 @@
+#!/bin/sh
+# The buttons (Ubuntu and OpenWrt; run by mu300-buttons.service / /etc/init.d/mu300-buttons):
+#   power, short press        wake the LEDs (they go dark after LED_TIMEOUT, see mu300-led)
+#   power, held 3 s           shut down cleanly (the battery-powered U30 Air; the F50 starts again on USB power)
+#   Wi-Fi key, short press    hotspot 2.4 <-> 5 GHz (U30 Air; the Wi-Fi LED shows the band: blue 5, white 2.4)
+#   Wi-Fi key, held 3 s       hotspot off / on
+# The V50 has a single key and it is neither of those (KEY_FN 464, "Function Key" in its device tree):
+#   that key, short press     hotspot 2.4 <-> 5 GHz
+#   that key, held 10 s       reboot
+# Every press lights the LEDs first (`mu300-led wake`: also in mu300-power's idle, and without any daemon), so a key
+# always shows life. Then it wakes mu300-power with the key's name (`mu300-power wake wifi|power`; other keys count as
+# power), in the background: the wake restores whatever is down by looking (hotspot, modem, LEDs, CPU), which can
+# take a minute, and the keys must not wait for it. Idle wakes on any key, a charging boot only on the Wi-Fi key. The
+# band toggle and the hotspot toggle act on an awake device, so the first Wi-Fi press on a sleeping device (idle, or
+# the LEDs held dark) only wakes it. Held power does not wake mu300-power: it leaves the shutdown marker, so the
+# daemon's stop on the way down does not bring the radios back. The hotspot toggle leaves $PST/hotspot-off (with the
+# uptime of the hold) while the user has it off, so neither a wake nor mu300-power's self-check turns it back on; the
+# direction is decided and the marker written before the wake starts, so the wake of the same press cannot undo it.
+# The toggles themselves (hotspot, band) run in the background under a deadline: a later press always shows life.
+# mu300-keys reports the presses; its tick every 5 s lets the LEDs time out. Ubuntu's logind leaves the power key
+# to this script (/etc/systemd/logind.conf.d/mu300-buttons.conf): it used to power the device off at a touch.
+export PATH="$PATH:/opt/mu300/bin:/usr/sbin:/sbin"
+KEY_POWER=116
+KEY_WIFI=138   # "Wifi Switch Key" in the U30 Air's device tree (KEY_HELP's code, as its Android maps it)
+# The V50's board has ONE key and it is neither of the two above: its device tree calls it key-function
+# with linux,code 0x1d0 = 464 = KEY_FN. Nothing matched that code, so on this device every press fell
+# through the case below and did nothing at all - no band switch, no shutdown. Measured, 2026-10-10:
+#   114 KEY_VOLUMEDOWN | 115 KEY_VOLUMEUP | 190 KEY_F20 (key-power) | 464 KEY_FN (key-function)
+KEY_FN=464
+is_openwrt() { [ -e /etc/openwrt_release ]; }
+PST=${MU300_RUN:-/run}/mu300/power
+LEDIDLE=${MU300_SYSROOT:-}/run/mu300/led/.idle   # mu300-led idle on (mu300-led keeps its state there)
+
+DEADLINE=${MU300_BUTTONS_DEADLINE:-150}   # a toggle in the background (the LED sync after wifi up runs 120 s)
+
+# How long a hold is, before it is reported as "long" (mu300-keys -l). 10 s on the V50, whose single
+# key reboots the device; the upstream 3 s everywhere else, for the F50/U30 Air power key. Told by the
+# device tree and not by the model: the V50 reports the same one as the F50 (DEVICE=f50), so the model
+# cannot tell them apart, and key-function is exactly the node that only this board has.
+HOLD=${MU300_BUTTONS_HOLD:-$([ -d /proc/device-tree/gpio-keys/key-function ] && echo 10000 || echo 3000)}
+
+# --- deadlines (as in mu300-power): "PID PPID" for every process, a process tree killed, a job with a watchdog
+proc_table() {
+    if [ -r /proc/self/stat ]; then
+        for _pt in /proc/[0-9]*; do
+            { read -r _ptl < "$_pt/stat"; } 2>/dev/null || continue
+            _ptl=${_ptl##*) }; _ptl=${_ptl#* }
+            echo "${_pt#/proc/} ${_ptl%% *}"
+        done
+    else
+        ps -A -o pid= -o ppid= 2>/dev/null
+    fi
+}
+# tree_kill PID: the process and everything it started. The tree is stopped until a look finds nothing new (a child
+# forked during one look is caught by the next), then every process any look saw is killed
+tree_kill() {
+    _tk_prev= _tk_seen= _tk_n=0
+    while :; do
+        _tk_all=$(proc_table | awk -v r="$1" '{ pp[$1] = $2 } END { s[r] = 1
+            do { n = 0; for (p in pp) if (!(p in s) && (pp[p] in s)) { s[p] = 1; n++ } } while (n)
+            for (p in s) print p }' | sort -n | tr '\n' ' ')
+        for _tk in $_tk_all; do kill -STOP "$_tk" 2>/dev/null; done
+        _tk_seen="$_tk_seen $_tk_all"   # every process seen: one reparented between looks is killed too
+        _tk_n=$((_tk_n + 1)); [ "$_tk_all" != "$_tk_prev" ] && [ "$_tk_n" -lt 10 ] || break
+        _tk_prev=$_tk_all
+    done
+    for _tk in $_tk_seen; do kill -KILL "$_tk" 2>/dev/null; done
+    return 0
+}
+in_background() {  # in_background SECONDS CMD...: CMD in the background; past SECONDS it and all it started are killed
+    _ib_s=$1; shift
+    ( "$@" & _ib_p=$!
+      ( sleep "$_ib_s"; tree_kill "$_ib_p" ) </dev/null >/dev/null 2>&1 & _ib_w=$!
+      wait "$_ib_p"; kill "$_ib_w" 2>/dev/null ) </dev/null >/dev/null 2>&1 &
+}
+
+probe() {  # probe CMD...: CMD within 5 s (the direction of a hold is decided before the wake; it must not wait long)
+    "$@" </dev/null >/dev/null 2>&1 &
+    _pr_p=$!
+    ( sleep "${MU300_BUTTONS_PROBE_DEADLINE:-5}"; tree_kill "$_pr_p" ) </dev/null >/dev/null 2>&1 &
+    _pr_w=$!
+    wait "$_pr_p"; _pr_rc=$?
+    kill "$_pr_w" 2>/dev/null; wait "$_pr_w" 2>/dev/null
+    return $_pr_rc
+}
+hotspot_is_up() {
+    if is_openwrt; then probe ubus -t 5 call hostapd.wlan0 get_status
+    else probe systemctl is-active --quiet mu300-hotspot; fi
+}
+hotspot_set() {  # hotspot_set on|off: the toggle itself
+    if is_openwrt; then
+        if [ "$1" = off ]; then wifi down; mu300-led wifi off; else wifi up; mu300-led wifi sync 120; fi
+    elif [ "$1" = off ]; then systemctl stop mu300-hotspot
+    else systemctl start mu300-hotspot; fi
+}
+band_toggle() { mu300-wifi-band toggle | logger -t mu300-buttons 2>/dev/null; }
+
+mu300-keys -l "$HOLD" -t 5 | { while read -r code kind; do
+    # the tick every 5 s is no press: it only lets the LEDs time out
+    if [ "$kind" = tick ]; then mu300-led sleep --if-due; continue; fi
+    mu300-led wake   # first, whatever else this key does or whatever state anything is in
+    was_idle=0; s=$(cat "$PST/state" 2>/dev/null); [ -z "$s" ] || [ "$s" = active ] || was_idle=1
+    [ ! -e "$LEDIDLE" ] || was_idle=1   # dark on purpose (idle, or someone's mu300-led idle on): this press only wakes
+    key=power; [ "$code" = "$KEY_WIFI" ] && key=wifi
+    # a Wi-Fi hold on an awake device: which way, and the user's marker, before the wake can look
+    dir=
+    if [ "$code $kind" = "$KEY_WIFI long" ] && [ "$was_idle" != 1 ]; then
+        mkdir -p "$PST" 2>/dev/null
+        if hotspot_is_up; then dir=off; cut -d. -f1 "${MU300_SYSROOT:-}/proc/uptime" > "$PST/hotspot-off" 2>/dev/null
+        else dir=on; rm -f "$PST/hotspot-off"; fi
+    fi
+    # a held power key shuts down instead
+    [ "$code $kind" = "$KEY_POWER long" ] || ( mu300-power wake "$key" ) </dev/null >/dev/null 2>&1 &
+    case "$code $kind" in
+        "$KEY_POWER long")
+            logger -t mu300-buttons "power button held: shutting down" 2>/dev/null
+            mkdir -p "$PST" 2>/dev/null; : > "$PST/shutdown" 2>/dev/null
+            if is_openwrt; then poweroff; else systemctl poweroff; fi ;;
+        "$KEY_WIFI short") [ "$was_idle" = 1 ] || in_background "$DEADLINE" band_toggle ;;
+        "$KEY_WIFI long") [ -z "$dir" ] || in_background "$DEADLINE" hotspot_set "$dir" ;;
+        # The V50's one key: a press switches the hotspot band, a 10 s hold reboots. The marker is left
+        # first for the same reason the hotspot toggle leaves one - a reboot must not be undone by a
+        # wake that puts the radios back.
+        "$KEY_FN short") [ "$was_idle" = 1 ] || in_background "$DEADLINE" band_toggle ;;
+        "$KEY_FN long")
+            logger -t mu300-buttons "V50 key held ${HOLD} ms: rebooting" 2>/dev/null
+            mkdir -p "$PST" 2>/dev/null; : > "$PST/reboot" 2>/dev/null
+            if is_openwrt; then reboot; else systemctl reboot; fi ;;
+    esac
+done; wait; }
diff --git a/openwrt/vendor-extra/opt/mu300/bin/mu300-lancheck b/openwrt/vendor-extra/opt/mu300/bin/mu300-lancheck
new file mode 100644
index 0000000..ea2cc58
--- /dev/null
+++ b/openwrt/vendor-extra/opt/mu300/bin/mu300-lancheck
@@ -0,0 +1,99 @@
+#!/bin/sh
+# Report - and if needed repair - the LAN path a client depends on, once per boot.
+#
+# Why this exists (V50, 2026-10-09): a client could associate with the hotspot and then get nothing at all.
+# Every part that decides whether it gets an address looked right afterwards - wlan0 a port of br-lan,
+# br-lan at 192.168.77.1/24, dhcp.lan a dhcpv4 server, dnsmasq running - but nothing recorded the state
+# AT BOOT, so a broken boot could not be told from a working one. The kernel log only showed the port
+# reaching forwarding state, and the userspace log had been flooded out of the ring buffer by the
+# sprd-wlan driver before anything could read it.
+#
+# The one thing this originally got wrong is the thing that actually broke the device: "the lan zone
+# accepting input" was read out of /etc/config/firewall, where it is an option that was set. In the
+# RENDERED ruleset the lan zone owned no interface at all, so fw4's input chain had no jump for
+# br-lan and its policy dropped everything a client sent. UCI said ACCEPT; nothing on the device
+# said otherwise. Hence fw-jump below, which reads the ruleset rather than the configuration.
+#
+# So: one line per boot with those facts, written to a file and to syslog. The next boot either proves the
+# path works or names the one part that does not.
+LOG=/tmp/mu300-lancheck.log
+say() { echo "$(cut -d' ' -f1 /proc/uptime) $*" >>$LOG 2>/dev/null; logger -t mu300-lancheck "$*" 2>/dev/null; }
+
+# netifd runs after mu300-post in the boot order; wait for the LAN to get its address (up to 2 minutes)
+i=0
+while [ $i -lt 24 ]; do
+    ip -4 addr show br-lan 2>/dev/null | grep -q 'inet ' && break
+    sleep 5
+    i=$((i + 1))
+done
+
+# The hotspot has to exist, be a port of the LAN bridge, AND be carrying traffic. All three are needed,
+# and the last two are why this was rewritten (V50, mainline kernel 6.18, 2026-10-10):
+#
+#   * wlan0 sat in the bridge with NO CARRIER and hostapd already given up. The original test asked only
+#     "is wlan0 missing from brif", so it never fired and the device booted with no hotspot, no DHCP
+#     server (udp67=0) and nothing on the device looking wrong.
+#   * on the mainline kernel the FIRST bring-up always fails and a retry always succeeds:
+#         at boot           hostapd: UNINITIALIZED->COUNTRY_UPDATE->DISABLED->AP-DISABLED
+#         wifi down; wifi up  hostapd: COUNTRY_UPDATE->HT_SCAN->ENABLED->AP-ENABLED
+#     `wifi up` alone does not clear it - the interface has to go down first - so every attempt does both.
+#   * and when this runs the interface may not exist yet at all: br-lan gets its address from the lan
+#     interface, which comes up before the wireless one. Guarding the whole block with `[ -d .../wlan0 ]`
+#     (the first version of this fix did) skipped the repair in exactly the case it was written for, and
+#     the log looked like a pass. Wait for wlan0 first, then repair.
+# The regulatory database FIRST, and before the Wi-Fi is restarted below so hostapd picks the country
+# up. cfg80211 asks for regulatory.db long before the rootfs is mounted and that first load always
+# fails ("cfg80211: failed to load regulatory.db"); without it cfg80211 is stuck on the world domain,
+# where EVERY 5 GHz channel is NO-IR, and hostapd refuses to start an AP:
+#
+#     Frequency 5180 (primary) not allowed for AP mode, flags: 0x40853 NO-IR
+#     Could not select hw_mode and channel. (-3)   ->   AP-DISABLED
+#
+# Verified on the device: after this runs, `iw reg set US` reports "country US: DFS-FCC" and the same
+# AP starts on channel 36; before it, `iw reg set` does nothing and the channel is refused. opt/mu300/bin/
+# regdb-load feeds the database through /sys/class/firmware for the pending request and reloads; running
+# it here, after netifd, is what makes the country in 90-mu300 mean anything. (V50, mainline 6.18,
+# 2026-10-10)
+/opt/mu300/bin/regdb-load >/dev/null 2>&1
+
+_wi=0
+while [ $_wi -lt 12 ] && [ ! -d /sys/class/net/wlan0 ]; do
+    sleep 5
+    _wi=$((_wi + 1))
+done
+_repair=0
+while [ $_repair -lt 3 ]; do
+    _st=$(cat /sys/class/net/wlan0/operstate 2>/dev/null)
+    _port=$(ls /sys/class/net/br-lan/brif 2>/dev/null | grep -c '^wlan0$')
+    _has=$( [ -d /sys/class/net/wlan0 ] && echo yes || echo no )
+    [ "$_has" = yes ] && [ "$_st" = up ] && [ "$_port" = 1 ] && break
+    _repair=$((_repair + 1))
+    say "wlan0 not serving (exists=$_has operstate=$_st bridge-port=$_port): wifi down; wifi up (attempt $_repair)"
+    wifi down 2>/dev/null
+    sleep 3
+    wifi up 2>/dev/null
+    sleep 20
+done
+
+br=$(ip -4 addr show br-lan 2>/dev/null | sed -n 's/.*inet \([0-9.]*\/[0-9]*\).*/\1/p' | tr '\n' ' ')
+ports=$(ls /sys/class/net/br-lan/brif 2>/dev/null | tr '\n' ' ')
+wst=$(cat /sys/class/net/wlan0/operstate 2>/dev/null)
+dm=$(pgrep dnsmasq 2>/dev/null | tr '\n' ' ')
+# Listening sockets, hex ports. 0016 = 22 ssh and 0050 = 80 http are TCP and live in /proc/net/tcp;
+# 0043 = 67 dhcp is UDP and lives in /proc/net/udp. Reading 67 out of /proc/net/tcp (as this did until
+# 2026-10-10) can only ever answer "nothing is listening", however healthy the DHCP server is.
+l22=$(grep -c ':0016 .* 0A ' /proc/net/tcp 2>/dev/null)
+l80=$(grep -c ':0050 .* 0A ' /proc/net/tcp 2>/dev/null)
+l67=$(grep -c ':0043 .* 0A ' /proc/net/udp 2>/dev/null)
+# The range dnsmasq was actually started with, not the one /etc/config/dhcp asks for. The generated file
+# has no fixed name (netifd writes /var/etc/dnsmasq.conf.cfg<hash>), so glob it without demanding a suffix.
+rng=$(grep -h '^dhcp-range' /var/etc/dnsmasq.conf* 2>/dev/null | tr '\n' ';')
+# Does fw4's input chain even hand br-lan to the lan zone? This is the one that decides everything:
+# fw4 works out a zone's devices from the ports of its bridge, and br-lan is declared bridge_empty with
+# wlan0 joining only when netifd brings the AP up. When that moment came too late the lan zone owned
+# nothing, the input policy dropped every packet, and a client that had associated got no lease, no DNS,
+# no LuCI and no SSH - while dnsmasq sat on 0.0.0.0:67 with a correct dhcp-range and never saw a
+# DISCOVER. Nothing else on the device looks wrong when that happens, which is why it is reported here.
+lanif=$(uci -q get network.lan.device 2>/dev/null)
+fwlan=$(nft list chain inet fw4 input 2>/dev/null | grep -c "\"${lanif:-br-lan}\" jump")
+say "br-lan=[$br] ports=[$ports] wlan0=$wst dnsmasq=[$dm] tcp22=$l22 tcp80=$l80 udp67=$l67 fw-jump=$fwlan range=[$rng]"
\ No newline at end of file
diff --git a/openwrt/vendor-extra/usr/libexec/unisoc-modem/dashboard-info b/openwrt/vendor-extra/usr/libexec/unisoc-modem/dashboard-info
new file mode 100644
index 0000000..ea88f33
--- /dev/null
+++ b/openwrt/vendor-extra/usr/libexec/unisoc-modem/dashboard-info
@@ -0,0 +1,331 @@
+#!/bin/sh
+# mu300-dash-info -- the dashboard's system/network snapshot: ONE line of JSON on stdout.
+#
+# The LuCI home page (luci-app-mu300) polls this through the rpcd backend
+# /usr/libexec/rpcd/mu300dash every few seconds. It reads only files and asks
+# ubus/uci/iw, so it never touches the modem's AT channel - the cell readings
+# live in mu300-dash-cell, which has its own cache and its own pace.
+#
+# CPU time and interface byte counters are "since boot" cumulative values; the
+# page subtracts two consecutive snapshots to get CPU% and live rates, so the
+# poll interval never skews the numbers.
+#
+# Every external call is wrapped in a hard timeout: netifd mid-reload or a wedged
+# driver must not void the whole snapshot (the same lesson the V50 panel learned
+# in the field - one hung call used to blank every readout on the page).
+#
+# Known traps this deliberately works around (docs/FINDINGS.md and the V50
+# research archive):
+#   * loadavg is meaningless here - three vendor kernel threads sit in D state
+#     and pin it around 3.5 forever. It is not reported at all.
+#   * iw/iwinfo never report tx-power or a sane channel on the sprd WCN driver;
+#     SSID/channel come from uci instead.
+#   * thermal zones are matched by type, never by zone number.
+
+export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/libexec/unisoc-modem:/usr/sbin:/sbin"
+# the shared JSON escaper and uci allow-lists (/usr/share/unisoc-modem/lib.sh)
+LIB=${0%/*}/../../share/unisoc-modem/lib.sh
+[ -f "$LIB" ] || LIB=/usr/share/unisoc-modem/lib.sh
+. "$LIB"
+
+BB=/opt/mu300/bin/busybox
+[ -x "$BB" ] || BB=busybox
+t3() { "$BB" timeout -s KILL 3 "$@" 2>/dev/null; }   # external asks: netifd, uci, iw...
+t2() { "$BB" timeout -s KILL 2 "$@" 2>/dev/null; }
+
+rd() { cat "$1" 2>/dev/null; }
+# numbers and strings through the shared helpers (lib.sh): host names, SSIDs
+# and the APN come from other people's devices and from uci
+n_or_null() { json_num "$1"; }
+f_or_null() { json_num "$1"; }
+qs() { json_str_or_null "$1"; }
+
+# ------------------------------------------------------------- temperature
+# type -> label, the four zones this SoC actually has; hottest covers the rest
+temp_of() {
+    local z t
+    for z in /sys/class/thermal/thermal_zone*; do
+        [ -r "$z/type" ] || continue
+        [ "$(rd "$z/type")" = "$1" ] || continue
+        t=$(rd "$z/temp")
+        [ -n "$t" ] || return 0
+        awk -v v="$t" 'BEGIN{printf "%.1f", v/1000}'
+        return 0
+    done
+}
+temp_hottest() {
+    rd /sys/class/thermal/thermal_zone*/temp 2>/dev/null | sort -n | tail -n1 | awk '{printf "%.1f", $1/1000}'
+}
+
+# ------------------------------------------------------- a ubus scalar field
+# the ubus CLI pretty-prints with spaces, so sed on the literal key; first match
+# wins (the fields used here appear once, ipv4 before ipv6 in the address blocks)
+jval() { printf '%s' "$1" | sed -n "s/.*\"$2\": *\"\{0,1\}\([^,\"}\]*\).*/\1/p" | head -n1; }
+
+# ----------------------------------------------------------------- WAN (ubus)
+# the UI can write these options: interface names only (they become ubus
+# object names, /sys paths and uci keys), else the defaults
+cfg() { uci_get "$1"; }
+DATA_IFACE=$(safe_iface "$(cfg data_interface)" wan)
+DATA_IFACE6=$(safe_iface "$(cfg data_interface_v6)" wan6)
+WANJSON=$(t3 ubus call "network.interface.$DATA_IFACE" status)
+WAN6JSON=$(t3 ubus call "network.interface.$DATA_IFACE6" status)
+DATA_DEVICE=$(safe_iface "$(cfg data_device)" '')
+[ -n "$DATA_DEVICE" ] || DATA_DEVICE=$(safe_iface "$(jval "$WANJSON" l3_device)" sipa_eth0)
+LAN_DEVICE=$(safe_iface "$(cfg lan_device)" br-lan)
+WIFI_DEVICE=$(safe_iface "$(cfg wifi_device)" wlan0)
+USB_DEVICE=$(safe_iface "$(cfg usb_device)" usb0)
+# The gadget netdev is usb0 in NCM/ECM mode and rndis0 in RNDIS mode (see boot/init
+# setup_usb_gadget). Neither the uci option nor the fallback above names that, so with RNDIS
+# selected this read a device that does not exist, net_obj returned null, and the status
+# dashboard reported the USB network as "Disconnected" while the link was up. (V50, 2026-10-10)
+if [ ! -d "/sys/class/net/$USB_DEVICE" ]; then
+	for _c in usb0 rndis0; do
+		[ -d "/sys/class/net/$_c" ] && { USB_DEVICE=$_c; break; }
+	done
+fi
+jaddr4() { printf '%s' "$1" | sed -n 's/.*"address": *"\([^"]*\)".*/\1/p' | head -n1; }
+# jsonfilter, not sed. Two independent reasons, both live on this device (V50, 2026-10-10):
+#   * `ubus call ... status` pretty-prints across several lines, so `"dns-server": [ ... ]` never
+#     matches inside ONE line and a line-oriented sed finds nothing at all - jarr_dns returned
+#     the empty string and the dashboard said "DNS --";
+#   * the leading `.*` in such a pattern is greedy, so even on a single line it would settle on
+#     the EMPTY "dns-server" array that "inactive" carries: the last one in the document, not the
+#     real one.
+# The interface had two servers configured the whole time. The field is a plain string here, so
+# the servers are space separated and home.js breaks them onto separate lines.
+jarr_dns() { t3 jsonfilter -s "$1" -e '@["dns-server"][*]' 2>/dev/null | tr '\n' ' ' | sed 's/  *$//'; }
+
+wan_up=$(jval "$WANJSON" up)
+[ "$wan_up" = "true" ] && wan_up=1 || wan_up=0
+wan_uptime=$(jval "$WANJSON" uptime)
+wan_proto=$(jval "$WANJSON" proto)
+wan_ip4=$(jaddr4 "$WANJSON")
+wan6_up=$(jval "$WAN6JSON" up)
+[ "$wan6_up" = "true" ] && wan6_up=1 || wan6_up=0
+wan6_ip=$(t2 ip -6 addr show "$DATA_DEVICE" 2>/dev/null | awk '/inet6 [23]/{split($2,s,"/"); print s[1]; exit}')
+wan_dns=$(jarr_dns "$WANJSON")
+apn=$(t3 uci -q get "network.$DATA_IFACE.apn")
+[ -n "$apn" ] || apn="(SIM default)"
+
+# ------------------------------------------------------------------- system
+NOW=$(date +%s)
+UPTIME=$(cut -d' ' -f1 /proc/uptime | cut -d. -f1)
+HOST=$(t3 uci -q get system.@system[0].hostname)
+[ -n "$HOST" ] || HOST=$(rd /proc/sys/kernel/hostname)
+MODEL=$(rd /tmp/sysinfo/model 2>/dev/null)
+[ -n "$MODEL" ] || MODEL=$(rd /proc/device-tree/model 2>/dev/null | tr -d '\0')
+FW=$(sed -n "s/^DISTRIB_DESCRIPTION='\(.*\)'$/\1/p" /etc/openwrt_release 2>/dev/null)
+[ -n "$FW" ] || FW=$(uname -sr)
+
+# /proc/stat first line: cpu user nice system idle iowait irq softirq steal ...
+# busy = everything except idle+iowait; the page deltas this against the last poll
+read -r _cpu _u _n _s _i _w _irq _sirq _st _rest < /proc/stat
+CPU_TOTAL=$(( _u + _n + _s + _i + _w + _irq + _sirq + _st ))
+CPU_IDLE=$(( _i + _w ))
+CPUN=$(grep -c '^processor' /proc/cpuinfo)
+# one freq pair per policy (big.LITTLE shows two; the page averages or shows both)
+FREQS=
+for p in /sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq; do
+    [ -r "$p" ] || continue
+    d=$(dirname "$p")
+    FREQS="$FREQS{\"cur\":$(n_or_null "$(rd "$p")"),\"max\":$(n_or_null "$(rd "$d/cpuinfo_max_freq")")},"
+done
+FREQS=${FREQS%,}
+
+MEM_T=$(awk '/^MemTotal/{print $2}' /proc/meminfo)
+MEM_A=$(awk '/^MemAvailable/{print $2}' /proc/meminfo)
+
+# df on / (the ext4 mu300root loop device)
+DF=$(df -k / 2>/dev/null | awk 'NR==2{print $2, $3, $4}')
+set -- $DF; DISK_T=$1; DISK_U=$2; DISK_A=$3
+
+T_SOC=$(temp_of soc-thmzone)
+T_CPU=$(temp_of apcpu0-thmzone)
+T_NR=$(temp_of nr0-thmzone)
+T_BRD=$(temp_of board-thmzone)
+T_HOT=$(temp_hottest)
+
+# ------------------------------------------------------------------- power
+# Only the U30 Air has a battery. Its fuel gauge is "battery" under 5.4 (the
+# vendor charger manager) and "sc27xx-fgu" under mainline (UMP9620, FINDINGS
+# 33d); any other supply of type Battery is taken after those. The F50 has
+# none, but the same PMIC: under mainline its fuel gauge appears with made-up
+# values, so an F50 reports no battery and the page hides the tile.
+# voltage_now is microvolts, current_now microamps: positive into the battery
+# under mainline (the status comes from bq256xx-charger, patch 0010; without
+# it patch 0006 derives "Charging" from current > 20 mA); the page goes by
+# status first, the sign only for Unknown and the like. An install
+# whose ramdisk does not name the device reads as an F50 under mainline (no
+# charger_policy_service in that device tree): no tile, never a wrong one. The
+# charger (5.4: "usb"/"ac") says whether external power is on and, where it
+# exposes them, the input voltage and current; mainline: bq256xx-charger (online only).
+PSY=${MU300_POWER_SUPPLY_DIR:-/sys/class/power_supply}
+P_DIR=
+if [ "$(mu300-device 2>/dev/null)" != f50 ]; then
+    for d in "$PSY/battery" "$PSY/sc27xx-fgu" "$PSY"/*; do
+        [ -d "$d" ] || continue
+        [ "$(rd "$d/present")" = 0 ] && continue
+        case ${d##*/} in
+            battery|sc27xx-fgu) [ -r "$d/capacity" ] || [ "$(rd "$d/type")" = Battery ] || continue ;;
+            *) [ "$(rd "$d/type")" = Battery ] || continue ;;
+        esac
+        P_DIR=$d; break
+    done
+fi
+P_PRESENT=0 P_CAP= P_STATUS= P_V= P_I= P_USB= P_IN_V= P_IN_I=
+if [ -n "$P_DIR" ]; then
+    P_PRESENT=1
+    P_CAP=$(rd "$P_DIR/capacity")
+    P_STATUS=$(rd "$P_DIR/status")
+    P_V=$(rd "$P_DIR/voltage_now")
+    P_I=$(rd "$P_DIR/current_now")
+    # the first USB/Mains supply that is online, else whether any says 0
+    for d in "$PSY"/*; do
+        case $(rd "$d/type") in USB*|Mains) ;; *) continue ;; esac
+        o=$(rd "$d/online")
+        case $o in 1) ;; 0) P_USB=0; continue ;; *) continue ;; esac
+        P_USB=1
+        P_IN_V=$(rd "$d/voltage_now")
+        P_IN_I=$(rd "$d/current_now")
+        [ -n "$P_IN_I" ] || P_IN_I=$(rd "$d/input_current_now")
+        break
+    done
+fi
+case "$P_CAP" in ''|*[!0-9]*) P_CAP= ;; esac
+# volts with two decimals, microamps as an integer, watts = |V x I| with two
+power_v() { awk -v v="$1" 'BEGIN{if(v ~ /^-?[0-9]+$/ && v+0>0)printf "%.2f",v/1000000}'; }
+power_i() { awk -v v="$1" 'BEGIN{if(v ~ /^-?[0-9]+$/)printf "%d",v}'; }
+power_w() { awk -v v="$1" -v i="$2" 'BEGIN{if(v ~ /^-?[0-9]+$/ && i ~ /^-?[0-9]+$/ && v+0>0){w=v*i/1e12; if(w<0)w=-w; printf "%.2f",w}}'; }
+P_W=$(power_w "$P_V" "$P_I")
+P_IN_W=$(power_w "$P_IN_V" "$P_IN_I")
+P_V=$(power_v "$P_V"); P_I=$(power_i "$P_I")
+P_IN_V=$(power_v "$P_IN_V"); P_IN_I=$(power_i "$P_IN_I")
+
+# ------------------------------------------------------- interface counters
+net_obj() {  # net_obj IFACE -> {"rx":N,"tx":N,"up":0|1} or null
+    local d=/sys/class/net/$1
+    [ -d "$d" ] || { echo null; return; }
+    local rx tx up
+    rx=$(rd "$d/statistics/rx_bytes"); tx=$(rd "$d/statistics/tx_bytes")
+    case "$(rd "$d/operstate")" in up) up=1 ;; *) up=0 ;; esac
+    printf '{"rx":%s,"tx":%s,"up":%d}' "$(n_or_null "$rx")" "$(n_or_null "$tx")" "$up"
+}
+
+# ------------------------------------------------------------------- Wi-Fi
+# configuration truth is uci (the driver reports nothing useful); per-client detail
+# comes from the driver's station table, names and addresses from the DHCP leases.
+# ONE "uci show wireless" instead of nine "uci get": each uci call costs a fork
+# plus config parse and they added up to most of this script's runtime.
+WSHOW=$(t3 uci -q show wireless 2>/dev/null)
+wu() {  # wu KEY -> value ('' when absent); KEY like "radio0.channel"
+    printf '%s\n' "$WSHOW" | sed -n "s/^wireless\\.$1='\\(.*\\)'$/\\1/p" | head -n1
+}
+# anonymous sections appear in "uci show" under their cfg id, and named ones use
+# their name - either way the section type line has no quotes; resolve the first
+# wifi-iface section once and read its options through that key
+IFKEY=$(printf '%s\n' "$WSHOW" | sed -n "s/^wireless\\.\\([^.]*\\)=wifi-iface\$/\\1/p" | head -n1)
+W_SSID=$(wu "${IFKEY:-x}.ssid")
+W_CH=$(wu 'radio0.channel')
+W_BAND=$(wu 'radio0.band')
+[ -n "$W_BAND" ] || W_BAND=$(wu 'radio0.hwmode')
+W_HT=$(wu 'radio0.htmode')   # HE80 / VHT40 / HT20 -> the number is the width
+W_WIDTH=$(printf '%s' "$W_HT" | tr -cd '0-9' | head -c 2)
+[ -n "$W_WIDTH" ] && W_WIDTH="$W_WIDTH MHz"
+W_COUNTRY=$(wu 'radio0.country')
+W_ENC=$(wu "${IFKEY:-x}.encryption")
+[ -n "$W_ENC" ] || W_ENC=none
+W_HIDDEN=$(wu "${IFKEY:-x}.hidden")
+W_HOSTAPD=0
+HAPD=$(t3 ubus call "hostapd.$WIFI_DEVICE" get_status 2>/dev/null)
+printf '%s' "$HAPD" | grep -q '"status": *"ENABLED"' && W_HOSTAPD=1
+W_DIS=$(wu 'radio0.disabled')
+[ "$W_DIS" = "1" ] && W_UP=0 || W_UP=1
+[ -d "/sys/class/net/$WIFI_DEVICE" ] || W_UP=0
+[ "$W_HOSTAPD" = 1 ] || W_UP=0
+# station table: one block per client - mac, signal, tx/rx bitrate, connected time
+W_CLIENTS=$(t3 iw dev "$WIFI_DEVICE" station dump 2>/dev/null | awk -F':\t*' '
+    /^Station / { mac = $2; sub(/ .*/, "", mac); sig = tx = rx = ct = "" }
+    /^	signal:/ { sig = $2 + 0 }
+    /^	tx bitrate:/ { tx = $2; sub(/ .*/, "", tx); sub(/$/, " Mbit/s", tx) }
+    /^	rx bitrate:/ { rx = $2; sub(/ .*/, "", rx); sub(/$/, " Mbit/s", rx) }
+    /^	connected time:/ { ct = $2 + 0; ct = int(ct / 60) + " min" }
+    mac != "" && sig != "" && !seen[mac]++ {
+        printf "%s|%s|%s|%s|%s\n", mac, sig, tx, rx, ct; sig = ""
+    }')
+W_CN=0; W_CLIST=
+while IFS='|' read -r mac sig txr rxr ct; do
+    [ -n "$mac" ] || continue
+    umac=$(echo "$mac" | tr 'a-f' 'A-F')
+    line=$(awk -v m="$umac" '$2 == m { print $3 "|" $4; exit }' /tmp/dhcp.leases 2>/dev/null)
+    ip=${line%%|*}; host=${line#*|}
+    [ "$host" = "$line" ] && host=
+    W_CLIST="$W_CLIST{\"mac\":$(qs "$mac"),\"host\":$(qs "$host"),\"ip\":$(qs "$ip"),\"signal\":$(n_or_null "$sig"),\"tx\":$(qs "$txr"),\"rx\":$(qs "$rxr"),\"conn\":$(qs "$ct")},"
+    W_CN=$((W_CN + 1))
+done <<EOF2
+$(printf '%s\n' "$W_CLIENTS")
+EOF2
+W_CLIST=${W_CLIST%,}
