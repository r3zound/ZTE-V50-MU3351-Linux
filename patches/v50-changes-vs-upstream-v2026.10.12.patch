+LAN_IP=$(t2 ip -4 addr show "$LAN_DEVICE" 2>/dev/null | awk '/inet /{split($2,a,"/"); print a[1]; exit}')
+
+# ---------------------------------------------------------------- modem/path
+# the same liveness rule mu300-atd uses: the URC log on nr0 is written to as
+# long as the modem is running, whatever it thinks of our commands
+URCLOG=/run/mu300-at/urc/stty_nr0.log
+if [ -f "$URCLOG" ]; then
+    AGE=$(( NOW - $(date -r "$URCLOG" +%s 2>/dev/null || echo 0) ))
+    [ "$AGE" -lt 240 ] && MODEM_ALIVE=1 || MODEM_ALIVE=0
+else
+    MODEM_ALIVE=0
+fi
+ATD_OK=0; /usr/libexec/unisoc-modem/at --available >/dev/null 2>&1 && ATD_OK=1
+[ "$MODEM_ALIVE" = 1 ] || MODEM_ALIVE=$ATD_OK
+DATA_PAUSED=0; [ -e /run/mu300-mobile-data-down ] && DATA_PAUSED=1
+CONNS=$(cat /proc/net/nf_conntrack 2>/dev/null | wc -l)
