+# here even when nobody is associated right now
+NOWS=$NOW
+LEASES=
+while read -r exp mac ip host _cid; do
+    [ -n "$mac" ] || continue
+    [ "$host" = "*" ] && host=
+    case $exp in ''|*[!0-9]*) exp=$NOWS ;; esac   # never a file value in $(( ))
+    left=$(( exp - NOWS ))
+    [ "$left" -lt 0 ] && left=0
+    LEASES="$LEASES{\"host\":$(qs "$host"),\"ip\":$(qs "$ip"),\"mac\":$(qs "$mac"),\"left\":$left},"
+done < /tmp/dhcp.leases 2>/dev/null
